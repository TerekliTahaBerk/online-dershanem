# Mobil uygulamanın konuşacağı web paneli (aynı Next.js backend'i; ikinci bir
# backend yok). Yerel geliştirme: iOS Simülatör host makineyle ağı paylaşır,
# `localhost` doğrudan çalışır. Android emülatörde `http://10.0.2.2:3000`.
# Geliştirme dışındaki derlemelerde HTTPS ZORUNLUDUR; değer yoksa veya http
# ise uygulama "sunucu adresi tanımlı değil" hatası gösterir.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Mağaza kimlikleri (yalnız `app.config.ts` okur; uydurulmaz, verilmezse
# alan yazılmaz). Bkz. docs/mobile/m1-implementation-report.md.
# MOBILE_IOS_BUNDLE_ID=
# MOBILE_ANDROID_PACKAGE=
# EAS_PROJECT_ID=

# Push (M5). EAS_PROJECT_ID yoksa push "desteklenmiyor" durumuna düşer; uydurulmaz.
# Sunucuya bilgi amaçlı gönderilen derleme ortamı: development | preview | production.
# EXPO_PUBLIC_APP_ENV=development
