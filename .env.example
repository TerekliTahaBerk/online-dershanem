# ─────────────────────────────────────────────────────────────────────────────
# Online Dershanem — Environment Variables
# Production'da Vercel Dashboard'tan; dev'de `.env.local` dosyasına kopyalayın.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Panel Feature Flag ─────────────────────────────────────────────────────
# Eski panel geçici olarak kapalıdır. Yeni panel geliştirilirken public site
# çalışmaya devam eder. İleride eski paneli test etmek için true yapılabilir.
# Sunucu/middleware → PANEL_ENABLED ; client/navbar → NEXT_PUBLIC_PANEL_ENABLED
PANEL_ENABLED=false
NEXT_PUBLIC_PANEL_ENABLED=false

# Public self-register kapalı (yeni ürün kuralı). Hesaplar satın alma sonrası
# admin/invite ile açılır. PASSWORD_RESET / davet akışları etkilenmez.
# Eski self-register'ı test için açmak isterseniz true yapın.
PUBLIC_REGISTER_ENABLED=false

# ─── Database (zorunlu) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/onlinedershanem?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/onlinedershanem?schema=public"
# Vercel Postgres Storage kullanıyorsanız `vercel env pull` aşağıdakileri
# verebilir — `lib/prisma-env.ts` otomatik alias'lar:
# STORAGE_DATABASE_URL=""
# STORAGE_PRISMA_DATABASE_URL=""
# STORAGE_POSTGRES_URL=""

# ─── Auth (zorunlu) ─────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret-min-32-chars"

# ─── Admin Seed ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@onlinedershanem.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Online Dershanem Admin"
LEAD_NOTIFICATION_EMAILS="admin@onlinedershanem.com"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxx"
MAIL_FROM="Online Dershanem <noreply@onlinedershanem.com>"

# ─── Ödeme (PayTR) ──────────────────────────────────────────────────────────
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYMENT_WEBHOOK_SECRET="replace-with-your-payment-webhook-secret"

# ─── Realtime (Pusher — opsiyonel) ──────────────────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ─── Push Notifications (Expo — opsiyonel ama prod'da önerilir) ─────────────
EXPO_ACCESS_TOKEN=""

# ─── Cron Jobs (Vercel) ─────────────────────────────────────────────────────
# /api/cron/* route'larını korumak için Bearer token.
# Vercel Cron UA fallback var ama prod'da MUTLAKA set edin.
CRON_SECRET="replace-with-random-bearer-token"

# ─── Cache (Upstash Redis — opsiyonel; yoksa in-memory fallback) ────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Logging ────────────────────────────────────────────────────────────────
# debug | info | warn | error  (default: prod=info, dev=debug)
LOG_LEVEL="info"
