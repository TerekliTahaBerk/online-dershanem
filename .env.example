# Panel rollout bayrakları. Yalnız baz ölçümleri varsayılan açık; gelecek ürün
# fazları kodu yayınlansa bile açıkça etkinleştirilmeden kullanıcıya açılmaz.
PANEL_FEATURE_BASELINE_METRICS="true"
PANEL_FEATURE_LEARNING_OUTCOMES="false"
PANEL_FEATURE_MOCK_EXAM_ANALYSIS="false"
PANEL_FEATURE_REVIEW_QUEUE="false"
PANEL_FEATURE_QUICK_LESSON_CLOSE="false"
PANEL_FEATURE_ADAPTIVE_PLAN="false"
PANEL_FEATURE_PARENT_WEEKLY_DIGEST="false"
PANEL_FEATURE_INTERVENTION_INBOX="false"
PANEL_FEATURE_RECOVERY_PACKAGE="false"
PANEL_FEATURE_ASSIGNMENT_EVIDENCE="false"
PANEL_FEATURE_STUDENT_CHECK_IN="false"
PANEL_FEATURE_ACCESSIBILITY_PROFILE="false"
PANEL_FEATURE_OFFLINE_MODE="false"
PANEL_FEATURE_COHORT_QUALITY="false"
PANEL_FEATURE_TEACHER_AI_DRAFTS="false"
PANEL_ROLLOUT_MODE="general"
PANEL_PILOT_KILL_SWITCH="false"
PANEL_PILOT_ACCEPTANCE_APPROVED="false"
PANEL_PILOT_SECURITY_REVIEW_APPROVED="false"
PANEL_LAST_RESTORE_DRILL_AT=""

# Online Deneme Kulübü bağımsız rollout kapıları. Yalnız tam olarak
# disabled|pilot|general kabul edilir; eksik/geçersiz değer disabled olur.
# Pilot modunda admin dışındaki kullanıcılar aktif bir ODK pilot koşusunun
# üyesi olmalıdır. General için üç onayın da true olması zorunludur.
ODK_ROLLOUT_MODE="disabled"
ODK_PILOT_KILL_SWITCH="false"
ODK_PILOT_ACCEPTANCE_APPROVED="false"
ODK_PILOT_SECURITY_REVIEW_APPROVED="false"
ODK_PILOT_OPERATIONS_APPROVED="false"
ODK_LAST_RESTORE_DRILL_AT=""
# Production deploy kapısı: Vercel production build'i bu sözleşmeyi otomatik
# çalıştırır. Lokal doğrulama: npm run validate:deploy-env -- --target=production
# Dış model aktarımı hukuk/operasyon onayı olmadan true yapmayın.
AI_DRAFT_EXTERNAL_TRANSFER_APPROVED="false"
AI_DRAFT_PROVIDER="fallback"
OPENAI_AI_DRAFT_MODEL=""
AI_DRAFT_MAX_DAILY_REQUESTS="10"
AI_DRAFT_MAX_DAILY_MICRO_USD="100000"
AI_DRAFT_INPUT_MICRO_USD_PER_MILLION_TOKENS=""
AI_DRAFT_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=""
# Production readiness için zorunlu: JSON kabul eden Slack/Teams/özel alarm webhook'u.
ERROR_ALERT_WEBHOOK_URL=""
# Vercel Blob private store — panel PDF/MP4 materyalleri için.
BLOB_READ_WRITE_TOKEN=""

# İşletme merkezi — dış entegrasyonlar açıkça etkinleştirilir.
#
# KURTARMA KAPISI (server-only): İşletme erişimi normalde YALNIZ
# BusinessRoleAssignment satırlarından gelir; platform ADMIN rolü tek başına
# hiçbir işletme izni vermez. Bu değişken yalnız atamaların kaybolduğu bir
# kurtarma senaryosu içindir: burada listelenen e-postaya sahip platform
# ADMIN'leri, HİÇ ataması yoksa geçici olarak SUPER_ADMIN kabul edilir ve
# kullanım `business.bootstrap_super_admin_used` olarak loglanır.
# Normal işletimde BOŞ bırakın. Virgülle ayrılmış e-posta listesi.
BUSINESS_BOOTSTRAP_SUPER_ADMIN_EMAILS=""
