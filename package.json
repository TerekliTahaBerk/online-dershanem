{
  "name": "onlinedershanem",
  "version": "0.1.1",
  "description": "A role-based online education, mock-exam, and business operations platform.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Taha Berk Terekli",
  "homepage": "https://onlinedershanem.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerekliTahaBerk/online-dershanem.git"
  },
  "bugs": {
    "url": "https://github.com/TerekliTahaBerk/online-dershanem/issues"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:deploy-env && prisma generate && next build",
    "build:nomigrate": "npm run validate:deploy-env && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:hygiene": "node scripts/check-repo-hygiene.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test lib/*.test.ts lib/auth/*.test.ts lib/business/*.test.ts lib/health/*.test.ts lib/jobs/*.test.ts lib/od/*.test.ts lib/odk/*.test.ts",
    "test:integration": "node --conditions react-server --import tsx --test tests/integration/business.integration.ts",
    "eval:teacher-ai": "node --import tsx scripts/eval-teacher-ai.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "release:migrate": "prisma migrate deploy",
    "inspect:odk-pilot": "node scripts/check-odk-pilot-config.mjs",
    "validate:deploy-env": "node --import tsx scripts/validate-deploy-env.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:bootstrap:fresh": "node scripts/bootstrap-fresh-db.mjs",
    "db:studio": "prisma studio",
    "scan:links": "tsx scripts/scan-broken-links.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:cross-browser": "PLAYWRIGHT_CROSS_BROWSER=true playwright test tests/e2e/panel-cross-browser.spec.ts",
    "e2e:odk": "PLAYWRIGHT_ODK_DEVICE_MATRIX=true playwright test tests/e2e/odk-exam-flow.spec.ts --workers=1",
    "e2e:odk-quality": "playwright test tests/e2e/odk-product-quality.spec.ts --workers=1",
    "e2e:odk-provisioning": "playwright test tests/e2e/odk-payment-provisioning.spec.ts --workers=1",
    "e2e:od-provisioning": "playwright test tests/e2e/od-payment-provisioning.spec.ts --workers=1",
    "e2e:install": "playwright install chromium webkit",
    "test:e2e": "playwright test",
    "lighthouse:ci": "lhci autorun",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^3.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^0.460.0",
    "next": "16.3.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "18.3.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.26",
    "sharp": "0.35.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
