{
  "name": "onlinedershanem",
  "version": "0.1.1",
  "description": "A role-based online education, mock-exam, and business operations platform.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Taha Berk Terekli",
  "homepage": "https://onlinedershanem.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerekliTahaBerk/online-dershanem.git"
  },
  "bugs": {
    "url": "https://github.com/TerekliTahaBerk/online-dershanem/issues"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:deploy-env && prisma generate && next build",
    "build:nomigrate": "npm run validate:deploy-env && prisma generate && next build",
    "build:analyze": "prisma generate && next build && node scripts/report-route-bundles.mjs --top 10",
    "analyze:bundle": "next experimental-analyze",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:a11y": "playwright test -c playwright.storybook.config.ts",
    "lint": "eslint .",
    "lint:hygiene": "node scripts/check-repo-hygiene.mjs",
    "lint:api-validation": "node scripts/check-api-input-validation.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test:unit": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:unit:coverage": "mkdir -p coverage && node --import tsx --enable-source-maps --test --experimental-test-coverage --test-coverage-include=\"lib/**/*.ts\" --test-coverage-exclude=\"lib/**/*.test.ts\" --test-coverage-lines=90 --test-coverage-branches=74 --test-coverage-functions=70 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"lib/**/*.test.ts\"",
    "test:integration": "node --conditions react-server --import tsx --test tests/integration/*.integration.ts",
    "eval:teacher-ai": "node --import tsx scripts/eval-teacher-ai.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:ci": "node scripts/prisma-migrate-deploy-ci.mjs",
    "release:migrate": "prisma migrate deploy",
    "inspect:odk-pilot": "node scripts/check-odk-pilot-config.mjs",
    "validate:deploy-env": "node --import tsx scripts/validate-deploy-env.ts",
    "backfill:student-success": "node --import tsx scripts/backfill-student-success.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:bootstrap:fresh": "node scripts/bootstrap-fresh-db.mjs",
    "db:verify:fresh": "node scripts/verify-fresh-db-integrity.mjs",
    "db:audit:enums": "node scripts/audit-prisma-enums.mjs",
    "db:studio": "prisma studio",
    "scan:links": "tsx scripts/scan-broken-links.ts",
    "e2e": "playwright test",
    "e2e:mfa": "PANEL_E2E_ADMIN_MFA_BYPASS=false playwright test tests/e2e/admin-mfa.spec.ts --workers=1",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:cross-browser": "PLAYWRIGHT_CROSS_BROWSER=true playwright test tests/e2e/panel-cross-browser.spec.ts",
    "e2e:odk": "PLAYWRIGHT_ODK_DEVICE_MATRIX=true playwright test tests/e2e/odk-exam-flow.spec.ts --workers=1",
    "e2e:odk-quality": "playwright test tests/e2e/odk-product-quality.spec.ts --workers=1",
    "e2e:auth-smoke": "CI=true PANEL_ENABLED=true PANEL_E2E_ADMIN_MFA_BYPASS=true playwright test tests/e2e/panel-auth-smoke.spec.ts --workers=1",
    "e2e:odk-provisioning": "playwright test tests/e2e/odk-payment-provisioning.spec.ts --workers=1",
    "e2e:od-provisioning": "playwright test tests/e2e/od-payment-provisioning.spec.ts --workers=1",
    "e2e:install": "playwright install chromium webkit",
    "test:e2e": "playwright test",
    "lighthouse:ci": "lhci autorun",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^3.0.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.44.0",
    "next": "^16.3.5",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.27.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "8.5.28",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "chrome-launcher": "1.2.1",
    "esbuild": "0.28.1",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
