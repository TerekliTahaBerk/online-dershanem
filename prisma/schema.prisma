generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PANEL — kimlik çekirdeği
//
// Public self-register YOKTUR: hesabı yalnızca ADMIN açar ve geçici parolayı
// elden (WhatsApp/telefon) iletir. Bu yüzden e-posta gönderimine bağlı hiçbir
// akış yok — parola sıfırlama da admin eliyle yapılır.
// ============================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CurriculumExam {
  LGS
  TYT
  AYT
  YDT
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OutcomeEvidenceType {
  TAUGHT
  OBSERVED
  INDEPENDENT
  NEEDS_REVIEW
}

enum MockExamErrorCategory {
  KNOWLEDGE
  PROCESS
  ATTENTION
  TIME
  BLANK
}

enum ReviewSourceType {
  MOCK_EXAM_SECTION
  LESSON_OUTCOME
  TEACHER_REFERENCE
}

enum ReviewItemStatus {
  ACTIVE
  MASTERED
  ARCHIVED
}

enum ReviewResponse {
  WRONG
  UNSURE
  CORRECT
}

model User {
  id String @id @default(cuid())

  /// DAİMA locale'siz küçük harf. `toLocaleLowerCase("tr")` KULLANMA:
  /// Türkçe locale'de "I" → "ı" olur ve e-postayı kalıcı olarak bozar.
  email String @unique

  /// scrypt — biçim: `scrypt$N$r$p$salt_b64$hash_b64` (bkz. lib/auth/password.ts)
  passwordHash String @map("password_hash")

  /// Admin geçici parola verdiği için ilk giriş zorunlu değişimle biter.
  mustChangePassword Boolean @default(true) @map("must_change_password")

  role   UserRole
  status UserStatus @default(ACTIVE)

  fullName String? @map("full_name")
  /// Parola bu numaradan iletiliyor — panelde kritik alan.
  phone    String?

  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")

  /// Hangi admin açtı. Admin silinse bile kullanıcı kaydı ayakta kalsın.
  createdById  String? @map("created_by_id")
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions                      Session[]
  studentProfile                StudentProfile?
  teacherProfile                TeacherProfile?
  parentStudents                ParentStudent[]            @relation("ParentLinks")
  taughtGroups                  Group[]                    @relation("GroupTeacher")
  taughtLessons                 Lesson[]                   @relation("LessonTeacher")
  createdAssignments            Assignment[]               @relation("AssignmentCreator")
  notifications                 Notification[]
  notificationPrefs             NotificationPreference?
  createdMaterials              LearningMaterial[]         @relation("MaterialCreator")
  noteTemplates                 TeacherNoteTemplate[]      @relation("TeacherNoteTemplateOwner")
  createdCurriculums            CurriculumVersion[]        @relation("CurriculumCreator")
  linkedLessonOutcomes          LessonOutcome[]            @relation("LessonOutcomeLinker")
  linkedAssignmentOutcomes      AssignmentOutcome[]        @relation("AssignmentOutcomeLinker")
  outcomeFavorites              OutcomeFavorite[]
  createdMockExams              MockExam[]                 @relation("MockExamCreator")
  reviewedMockExams             MockExam[]                 @relation("MockExamReviewer")
  revisedMockExamReasons        MockExamSectionError[]     @relation("MockExamErrorReviser")
  createdReviewItems            ReviewItem[]               @relation("ReviewItemCreator")
  ownedInterventionCases        InterventionCase[]         @relation("InterventionCaseOwner")
  interventionActivities        InterventionCaseActivity[]
  generatedRecoveryPackages     RecoveryPackage[]          @relation("RecoveryPackageGenerator")
  publishedRecoveryPackages     RecoveryPackage[]          @relation("RecoveryPackagePublisher")
  reviewedAssignmentSubmissions AssignmentSubmission[]     @relation("AssignmentSubmissionReviewer")
  odOrders                      OdOrder[]

  @@index([role, status])
  @@index([createdById])
  @@map("users")
}

enum LessonStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  LESSON_SUMMARY
  ABSENCE
  ASSIGNMENT
  PAYMENT
  SYSTEM
}

enum MaterialKind {
  LINK
  PDF
  VIDEO
}

model StudentProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique @map("user_id")
  classLevel            String?                @map("class_level")
  schoolName            String?                @map("school_name")
  targetGoal            String?                @map("target_goal")
  weeklyGoal            String?                @map("weekly_goal")
  weeklyGoalUpdatedAt   DateTime?              @map("weekly_goal_updated_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents               ParentStudent[]
  enrollments           Enrollment[]
  notes                 LessonNote[]
  attendances           Attendance[]
  assignmentProgress    AssignmentProgress[]
  mockExams             MockExam[]
  reviewItems           ReviewItem[]
  planPreference        StudentPlanPreference?
  weeklyPlans           WeeklyPlan[]
  weeklyDigests         WeeklyDigest[]
  interventionCases     InterventionCase[]
  recoveryPackages      RecoveryPackage[]
  assignmentSubmissions AssignmentSubmission[]

  @@map("student_profiles")
}

enum WeeklyDigestStatus {
  DRAFT
  PUBLISHED
}

model WeeklyDigest {
  id            String                 @id @default(cuid())
  studentId     String                 @map("student_id")
  weekStart     DateTime               @map("week_start")
  status        WeeklyDigestStatus     @default(DRAFT)
  ruleVersion   String                 @default("calm-digest-v1") @map("rule_version")
  trendBand     String                 @map("trend_band")
  goodThingOne  String                 @map("good_thing_one")
  goodThingTwo  String                 @map("good_thing_two")
  supportArea   String                 @map("support_area")
  homeQuestion  String                 @map("home_question")
  dataThrough   DateTime               @map("data_through")
  generatedById String                 @map("generated_by_id")
  publishedById String?                @map("published_by_id")
  publishedAt   DateTime?              @map("published_at")
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  student       StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feedback      WeeklyDigestFeedback[]

  @@unique([studentId, weekStart])
  @@index([status, weekStart])
  @@map("weekly_digests")
}

model WeeklyDigestFeedback {
  id           String       @id @default(cuid())
  digestId     String       @map("digest_id")
  userId       String       @map("user_id")
  viewerRole   UserRole     @map("viewer_role")
  helpful      Boolean?
  anxietyPulse Int?         @map("anxiety_pulse")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  digest       WeeklyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@unique([digestId, userId])
  @@index([viewerRole, createdAt])
  @@map("weekly_digest_feedback")
}

enum WeeklyPlanStatus {
  DRAFT
  APPROVED
  CHANGE_REQUESTED
  ARCHIVED
}

enum InterventionCaseStatus {
  OPEN
  IN_PROGRESS
  SNOOZED
  RESOLVED
  FALSE_POSITIVE
}

enum InterventionReason {
  ATTENDANCE_PATTERN
  OVERDUE_WORK
  REPEATED_REVIEW_DIFFICULTY
  PLAN_STALLED
}

enum InterventionActivityType {
  GENERATED
  ASSIGNED
  STARTED
  ACTION_LOGGED
  SNOOZED
  RESOLVED
  FALSE_POSITIVE
  REOPENED
}

enum InterventionOutcome {
  CHECK_IN_COMPLETED
  SUPPORT_PLANNED
  PRACTICE_ADJUSTED
  FAMILY_CONTACTED
  NO_ACTION_NEEDED
  OTHER
}

enum InterventionFalsePositiveReason {
  CONTEXT_MISSING
  DATA_OUTDATED
  THRESHOLD_TOO_SENSITIVE
  DUPLICATE
  OTHER
}

model InterventionCase {
  id              String                     @id @default(cuid())
  studentId       String                     @map("student_id")
  ruleVersion     String                     @default("intervention-v1") @map("rule_version")
  reasonCode      InterventionReason         @map("reason_code")
  fingerprint     String                     @unique
  explanation     String
  suggestedAction String                     @map("suggested_action")
  evidenceCount   Int                        @map("evidence_count")
  windowStart     DateTime                   @map("window_start")
  windowEnd       DateTime                   @map("window_end")
  dueAt           DateTime                   @map("due_at")
  status          InterventionCaseStatus     @default(OPEN)
  ownerId         String?                    @map("owner_id")
  firstActionAt   DateTime?                  @map("first_action_at")
  snoozedUntil    DateTime?                  @map("snoozed_until")
  resolvedAt      DateTime?                  @map("resolved_at")
  outcomeCode     InterventionOutcome?       @map("outcome_code")
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  student         StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  owner           User?                      @relation("InterventionCaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities      InterventionCaseActivity[]

  @@index([status, dueAt])
  @@index([studentId, status, createdAt])
  @@index([ownerId, status, dueAt])
  @@map("intervention_cases")
}

model InterventionCaseActivity {
  id                  String                           @id @default(cuid())
  caseId              String                           @map("case_id")
  actorId             String?                          @map("actor_id")
  type                InterventionActivityType
  outcomeCode         InterventionOutcome?             @map("outcome_code")
  falsePositiveReason InterventionFalsePositiveReason? @map("false_positive_reason")
  note                String?
  createdAt           DateTime                         @default(now()) @map("created_at")
  case                InterventionCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor               User?                            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@map("intervention_case_activities")
}

enum WeeklyPlanTaskStatus {
  PLANNED
  DONE
  SKIPPED
}

enum WeeklyPlanTaskSource {
  ASSIGNMENT
  REVIEW
  WEAK_OUTCOME
  EXAM_PREP
  RECOVERY
}

enum WeeklyPlanReason {
  DUE_SOON
  REVIEW_DUE
  NEEDS_REVIEW
  EXAM_APPROACHING
  CAPACITY_BALANCE
  MISSED_LESSON
}

model StudentPlanPreference {
  id              String         @id @default(cuid())
  studentId       String         @unique @map("student_id")
  availableDays   Json           @map("available_days")
  minutesPerDay   Int            @default(45) @map("minutes_per_day")
  maxTasksPerDay  Int            @default(3) @map("max_tasks_per_day")
  nextExamAt      DateTime?      @map("next_exam_at")
  examLabel       String?        @map("exam_label")
  planningEnabled Boolean        @default(true) @map("planning_enabled")
  overwhelmPulse  Int?           @map("overwhelm_pulse")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_plan_preferences")
}

model WeeklyPlan {
  id                    String           @id @default(cuid())
  studentId             String           @map("student_id")
  weekStart             DateTime         @map("week_start")
  status                WeeklyPlanStatus @default(DRAFT)
  ruleVersion           String           @default("adaptive-v1") @map("rule_version")
  capacityMinutes       Int              @map("capacity_minutes")
  createdById           String           @map("created_by_id")
  approvedById          String?          @map("approved_by_id")
  approvedAt            DateTime?        @map("approved_at")
  changeRequestCategory String?          @map("change_request_category")
  version               Int              @default(1)
  generatedAt           DateTime         @default(now()) @map("generated_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  student               StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tasks                 WeeklyPlanTask[]

  @@unique([studentId, weekStart])
  @@index([status, weekStart])
  @@map("weekly_plans")
}

model WeeklyPlanTask {
  id                String               @id @default(cuid())
  planId            String               @map("plan_id")
  scheduledFor      DateTime             @map("scheduled_for")
  position          Int
  title             String
  durationMinutes   Int                  @map("duration_minutes")
  sourceType        WeeklyPlanTaskSource @map("source_type")
  sourceReferenceId String?              @map("source_reference_id")
  reasonCode        WeeklyPlanReason     @map("reason_code")
  status            WeeklyPlanTaskStatus @default(PLANNED)
  completedAt       DateTime?            @map("completed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  plan              WeeklyPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, scheduledFor, position])
  @@index([planId, status, scheduledFor])
  @@map("weekly_plan_tasks")
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  subjects  String[] @default([])
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model TeacherNoteTemplate {
  id        String   @id @default(cuid())
  teacherId String   @map("teacher_id")
  title     String
  note      String?
  nextGoal  String?  @map("next_goal")
  homework  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  teacher   User     @relation("TeacherNoteTemplateOwner", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, updatedAt])
  @@map("teacher_note_templates")
}

model ParentStudent {
  id           String         @id @default(cuid())
  parentId     String         @map("parent_id")
  studentId    String         @map("student_id")
  relationship String?
  createdAt    DateTime       @default(now()) @map("created_at")
  parent       User           @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

model Group {
  id          String             @id @default(cuid())
  name        String
  subject     String
  level       String?
  capacity    Int                @default(4)
  teacherId   String             @map("teacher_id")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  teacher     User               @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  lessons     Lesson[]
  assignments Assignment[]
  materials   LearningMaterial[]

  @@index([teacherId, isActive])
  @@map("groups")
}

model Enrollment {
  id        String         @id @default(cuid())
  groupId   String         @map("group_id")
  studentId String         @map("student_id")
  startedAt DateTime       @default(now()) @map("started_at")
  endedAt   DateTime?      @map("ended_at")
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId, endedAt])
  @@map("enrollments")
}

model Lesson {
  id                  String             @id @default(cuid())
  groupId             String             @map("group_id")
  teacherId           String             @map("teacher_id")
  title               String
  startsAt            DateTime           @map("starts_at")
  endsAt              DateTime           @map("ends_at")
  status              LessonStatus       @default(PLANNED)
  meetingUrl          String?            @map("meeting_url")
  outcomeSkipReason   String?            @map("outcome_skip_reason")
  closeVersion        Int                @default(0) @map("close_version")
  closeIdempotencyKey String?            @map("close_idempotency_key")
  closeRequestHash    String?            @map("close_request_hash")
  completedAt         DateTime?          @map("completed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  group               Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher             User               @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  notes               LessonNote[]
  attendances         Attendance[]
  assignments         Assignment[]
  materials           LearningMaterial[]
  outcomeLinks        LessonOutcome[]
  reviewItems         ReviewItem[]
  recoveryPackages    RecoveryPackage[]

  @@index([teacherId, startsAt])
  @@index([groupId, startsAt])
  @@map("lessons")
}

model LessonNote {
  id        String          @id @default(cuid())
  lessonId  String          @map("lesson_id")
  studentId String?         @map("student_id")
  topic     String?
  note      String?
  nextGoal  String?         @map("next_goal")
  homework  String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([studentId, updatedAt])
  @@map("lesson_notes")
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String           @map("lesson_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, createdAt])
  @@map("attendances")
}

enum AssignmentProgressStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Assignment {
  id                String                      @id @default(cuid())
  groupId           String                      @map("group_id")
  lessonId          String?                     @map("lesson_id")
  createdById       String                      @map("created_by_id")
  title             String
  description       String?
  dueAt             DateTime                    @map("due_at")
  isActive          Boolean                     @default(true) @map("is_active")
  outcomeSkipReason String?                     @map("outcome_skip_reason")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  group             Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson            Lesson?                     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy         User                        @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  progress          AssignmentProgress[]
  materials         LearningMaterial[]
  outcomeLinks      AssignmentOutcome[]
  recoveryItems     RecoveryPackageItem[]
  evidenceRequired  Boolean                     @default(false) @map("evidence_required")
  rubricCriteria    AssignmentRubricCriterion[]
  submissions       AssignmentSubmission[]

  @@index([groupId, dueAt])
  @@index([createdById, isActive])
  @@map("assignments")
}

model AssignmentProgress {
  id           String                   @id @default(cuid())
  assignmentId String                   @map("assignment_id")
  studentId    String                   @map("student_id")
  status       AssignmentProgressStatus @default(TODO)
  completedAt  DateTime?                @map("completed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  assignment   Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, status, updatedAt])
  @@map("assignment_progress")
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum RubricLevel {
  NEEDS_WORK
  DEVELOPING
  MEETS
}

model AssignmentRubricCriterion {
  id           String                  @id @default(cuid())
  assignmentId String                  @map("assignment_id")
  position     Int
  label        String
  createdAt    DateTime                @default(now()) @map("created_at")
  assignment   Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scores       AssignmentRubricScore[]

  @@unique([assignmentId, position])
  @@index([assignmentId])
  @@map("assignment_rubric_criteria")
}

model AssignmentSubmission {
  id             String                     @id @default(cuid())
  assignmentId   String                     @map("assignment_id")
  studentId      String                     @map("student_id")
  attemptNumber  Int                        @map("attempt_number")
  status         AssignmentSubmissionStatus @default(SUBMITTED)
  textEvidence   String                     @map("text_evidence")
  feedback       String?
  idempotencyKey String                     @unique @map("idempotency_key")
  reviewerId     String?                    @map("reviewer_id")
  submittedAt    DateTime                   @default(now()) @map("submitted_at")
  reviewedAt     DateTime?                  @map("reviewed_at")
  version        Int                        @default(1)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  assignment     Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer       User?                      @relation("AssignmentSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  scores         AssignmentRubricScore[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, status, submittedAt])
  @@index([studentId, submittedAt])
  @@map("assignment_submissions")
}

model AssignmentRubricScore {
  id           String                    @id @default(cuid())
  submissionId String                    @map("submission_id")
  criterionId  String                    @map("criterion_id")
  level        RubricLevel
  createdAt    DateTime                  @default(now()) @map("created_at")
  submission   AssignmentSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion    AssignmentRubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
  @@index([criterionId])
  @@map("assignment_rubric_scores")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId          String   @id @map("user_id")
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  whatsappEnabled Boolean  @default(false) @map("whatsapp_enabled")
  lessonSummary   Boolean  @default(true) @map("lesson_summary")
  weeklyDigest    Boolean  @default(true) @map("weekly_digest")
  absence         Boolean  @default(true)
  assignment      Boolean  @default(true)
  payment         Boolean  @default(true)
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model LearningMaterial {
  id            String                @id @default(cuid())
  groupId       String                @map("group_id")
  lessonId      String?               @map("lesson_id")
  assignmentId  String?               @map("assignment_id")
  createdById   String                @map("created_by_id")
  title         String
  description   String?
  url           String
  blobPathname  String?               @map("blob_pathname")
  fileName      String?               @map("file_name")
  mimeType      String?               @map("mime_type")
  fileSize      Int?                  @map("file_size")
  kind          MaterialKind          @default(LINK)
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  group         Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson        Lesson?               @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignment    Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy     User                  @relation("MaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recoveryItems RecoveryPackageItem[]

  @@index([groupId, isActive, createdAt])
  @@map("learning_materials")
}

enum RecoveryPackageStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum RecoveryItemKind {
  MATERIAL
  ASSIGNMENT
}

enum RecoveryCheckpointResponse {
  NOT_YET
  NEED_HELP
  READY
}

model RecoveryPackage {
  id                 String                      @id @default(cuid())
  lessonId           String                      @map("lesson_id")
  studentId          String                      @map("student_id")
  status             RecoveryPackageStatus       @default(DRAFT)
  ruleVersion        String                      @default("recovery-v1") @map("rule_version")
  summaryTopic       String                      @map("summary_topic")
  summaryNextStep    String                      @map("summary_next_step")
  checkpointPrompt   String                      @map("checkpoint_prompt")
  checkpointResponse RecoveryCheckpointResponse? @map("checkpoint_response")
  dueAt              DateTime                    @map("due_at")
  generatedById      String                      @map("generated_by_id")
  publishedById      String?                     @map("published_by_id")
  publishedAt        DateTime?                   @map("published_at")
  firstViewedAt      DateTime?                   @map("first_viewed_at")
  completedAt        DateTime?                   @map("completed_at")
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  lesson             Lesson                      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student            StudentProfile              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generatedBy        User                        @relation("RecoveryPackageGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  publishedBy        User?                       @relation("RecoveryPackagePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
