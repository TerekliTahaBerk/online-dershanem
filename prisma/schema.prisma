generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

enum IntakeStatus {
  NEW
  REVIEWING
  CONTACTED
  ENROLLED
  ARCHIVED
}

enum PurchaseEventType {
  FORM_SUBMITTED
  PAYMENT_LINK_OPENED
  CALLBACK_RECEIVED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
  ABANDONED
}

enum AuditActorType {
  SYSTEM
  USER
}

enum PackageType {
  COURSE
  EXAM
}

enum OdkOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum OdkPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OdkPaymentProvider {
  MANUAL
  IYZICO
  BANK_TRANSFER
  PAYTR
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponService {
  OD
  ODK
  ALL
}

model EmailOutbox {
  id          String            @id @default(cuid())
  recipients  String
  subject     String
  html        String
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  sentAt      DateTime?         @map("sent_at")
  nextRetryAt DateTime?         @map("next_retry_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@map("email_outbox")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model LeadSubmission {
  id           String       @id @default(cuid())
  fullName     String
  phone        String
  classLevel   String
  examType     String
  targetGoal   String
  currentNet   String
  parentPhone  String?
  kvkkConsent  Boolean
  source       String
  intakeStatus IntakeStatus @default(NEW)
  adminNotes   String?
  taskLabel    String?
  nextActionAt DateTime?
  submittedAt  DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([intakeStatus, submittedAt])
}

model PurchaseIntent {
  id               String          @id @default(cuid())
  source           String
  packageName      String
  paymentLink      String?
  studentFullName  String
  studentPhone     String
  studentEmail     String
  schoolName       String
  city             String
  district         String
  classLevel       String
  department       String?
  examType         String
  targetSchool     String?
  targetRanking    String
  currentLevel     String
  currentNet       String
  weakLessons      String
  strongLessons    String?
  needType         String
  studyStatus      String
  weeklyStudyHours String
  parentFullName   String?
  parentPhone      String?
  parentEmail      String?
  notes            String?
  kvkkConsent      Boolean
  paymentConsent   Boolean
  status           PurchaseStatus  @default(PENDING)
  intakeStatus     IntakeStatus    @default(NEW)
  adminNotes       String?
  taskLabel        String?
  nextActionAt     DateTime?
  submittedAt      DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           PurchaseEvent[]

  @@index([intakeStatus, submittedAt])
}

model PurchaseEvent {
  id                String            @id @default(cuid())
  purchaseIntentId  String
  eventType         PurchaseEventType
  status            PurchaseStatus
  source            String
  packageName       String
  paymentLink       String?
  provider          String?
  providerReference String?
  payload           Json?
  createdAt         DateTime          @default(now())
  purchaseIntent    PurchaseIntent    @relation(fields: [purchaseIntentId], references: [id], onDelete: Cascade)

  @@index([purchaseIntentId, createdAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorUserId String?
  actorType   AuditActorType @default(SYSTEM)
  entityType  String
  entityId    String
  action      String
  summary     String?
  payload     Json?
  createdAt   DateTime       @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model Package {
  id          String      @id @default(cuid())
  name        String
  type        PackageType @default(COURSE)
  description String?
  price       Int
  paytrLink   String?
  lessonCount Int
  subjects    String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  odOrders    OdOrder[]

  @@index([isActive])
  @@index([type, isActive])
}

model OdkPackage {
  id                 String     @id @default(cuid())
  title              String
  slug               String     @unique
  description        String?
  priceCents         Int        @map("price_cents")
  originalPriceCents Int?       @map("original_price_cents")
  durationDays       Int?       @map("duration_days")
  isActive           Boolean    @default(true) @map("is_active")
  isFeatured         Boolean    @default(false) @map("is_featured")
  ctaText            String?    @map("cta_text")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  orders             OdkOrder[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("odk_packages")
}

model OdkOrder {
  id            String         @id @default(cuid())
  packageId     String         @map("package_id")
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  package       OdkPackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments      OdkPayment[]

  @@index([status, createdAt])
  @@map("odk_orders")
}

model OdkPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(MANUAL)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdkOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("odk_payments")
}

model OdOrder {
  id            String         @id @default(cuid())
  packageId     String?        @map("package_id")
  packageName   String         @map("package_name")
  category      String?
  subject       String?
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  intentId      String?        @map("intent_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments      OdPayment[]

  @@index([status, createdAt])
  @@index([intentId])
  @@map("od_orders")
}

model OdPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(PAYTR)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("od_payments")
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             CouponType         @default(PERCENT)
  service          CouponService      @default(ALL)
  value            Int
  minOrderCents    Int                @default(0) @map("min_order_cents")
  maxDiscountCents Int                @default(0) @map("max_discount_cents")
  usageLimit       Int                @default(0) @map("usage_limit")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  startsAt         DateTime?          @map("starts_at")
  expiresAt        DateTime?          @map("expires_at")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  redemptions      CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String   @map("coupon_id")
  customerKey   String   @map("customer_key")
  orderService  String   @map("order_service")
  orderId       String   @map("order_id")
  discountCents Int      @map("discount_cents")
  redeemedAt    DateTime @default(now()) @map("redeemed_at")
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerKey])
  @@index([orderService, orderId])
  @@map("coupon_redemptions")
}
