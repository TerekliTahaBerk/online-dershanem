model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// Çerezdeki opak token'ın sha256'sı. Düz token ASLA saklanmaz —
  /// DB sızarsa oturumlar ele geçirilemesin.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// Password authentication establishes the session; ADMIN privilege is
  /// withheld until `mfaVerifiedAt` is set by a fresh second-factor ceremony.
  primaryAuthenticatedAt DateTime  @default(now()) @map("primary_authenticated_at") @db.Timestamptz(3)
  mfaVerifiedAt          DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
