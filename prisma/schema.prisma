generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

enum PurchaseEventType {
  FORM_SUBMITTED
  PAYMENT_LINK_OPENED
  CALLBACK_RECEIVED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeadSubmission {
  id            String       @id @default(cuid())
  fullName      String
  phone         String
  classLevel    String
  examType      String
  targetGoal    String
  currentNet    String
  parentPhone   String?
  kvkkConsent   Boolean
  source        String
  submittedAt   DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PurchaseIntent {
  id                String           @id @default(cuid())
  source            String
  packageName       String
  paymentLink       String?
  studentFullName   String
  studentPhone      String
  studentEmail      String
  schoolName        String
  city              String
  district          String
  classLevel        String
  department        String?
  examType          String
  targetRanking     String
  currentLevel      String
  currentNet        String
  weakLessons       String
  strongLessons     String?
  needType          String
  studyStatus       String
  weeklyStudyHours  String
  parentFullName    String?
  parentPhone       String?
  parentEmail       String?
  notes             String?
  kvkkConsent       Boolean
  paymentConsent    Boolean
  status            PurchaseStatus   @default(PENDING)
  submittedAt       DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  events            PurchaseEvent[]
}

model PurchaseEvent {
  id               String            @id @default(cuid())
  purchaseIntentId String
  eventType        PurchaseEventType
  status           PurchaseStatus
  source           String
  packageName      String
  paymentLink      String?
  provider         String?
  providerReference String?
  payload          Json?
  createdAt        DateTime          @default(now())
  purchaseIntent   PurchaseIntent    @relation(fields: [purchaseIntentId], references: [id], onDelete: Cascade)

  @@index([purchaseIntentId, createdAt])
}
