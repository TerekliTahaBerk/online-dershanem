generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PANEL — kimlik çekirdeği
//
// Public self-register YOKTUR: hesabı yalnızca ADMIN açar ve geçici parolayı
// elden (WhatsApp/telefon) iletir. Bu yüzden e-posta gönderimine bağlı hiçbir
// akış yok — parola sıfırlama da admin eliyle yapılır.
// ============================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductCode {
  OD
  ODK
}

enum ProductAccessSource {
  MANUAL
  PURCHASE
  STAFF
  PROMOTION
  LEGACY_BACKFILL
}

enum OdkExamFamily {
  LGS
  TYT
  AYT
}

enum OdkExamStatus {
  DRAFT
  READY
  SCHEDULED
  LIVE
  ENDED
  SCORED
  RELEASED
  ARCHIVED
}

enum OdkExamVersionStatus {
  DRAFT
  LOCKED
  RETIRED
}

enum OdkQuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum OdkAnswerOption {
  A
  B
  C
  D
  E
}

enum OdkExamFileType {
  BOOKLET_PDF
  ANSWER_KEY_PDF
}

enum OdkAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  VOID
}

enum OdkQuestionResult {
  CORRECT
  WRONG
  BLANK
}

enum CurriculumExam {
  LGS
  TYT
  AYT
  YDT
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OutcomeEvidenceType {
  TAUGHT
  OBSERVED
  INDEPENDENT
  NEEDS_REVIEW
}

enum MockExamErrorCategory {
  KNOWLEDGE
  PROCESS
  ATTENTION
  TIME
  BLANK
}

enum AiDraftTaskType {
  ASSIGNMENT
  MINI_CHECK
}

enum AiDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  FLAGGED
}

enum AiDraftProvider {
  OPENAI
  FALLBACK
  STUB
}

enum AiDraftFlagReason {
  FACTUAL_ERROR
  UNSUPPORTED_CITATION
  UNSAFE_TONE
  PRIVACY
  OTHER
}

enum PilotCohortStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ROLLED_BACK
}

enum PilotStopReason {
  GUARDRAIL_BREACH
  SECURITY_INCIDENT
  DATA_QUALITY
  OPERATIONAL
  MANUAL_COMPLETION
}

enum ReviewSourceType {
  MOCK_EXAM_SECTION
  LESSON_OUTCOME
  TEACHER_REFERENCE
}

enum ReviewItemStatus {
  ACTIVE
  MASTERED
  ARCHIVED
}

enum ReviewResponse {
  WRONG
  UNSURE
  CORRECT
}

model User {
  id String @id @default(cuid())

  /// DAİMA locale'siz küçük harf. `toLocaleLowerCase("tr")` KULLANMA:
  /// Türkçe locale'de "I" → "ı" olur ve e-postayı kalıcı olarak bozar.
  email String @unique

  /// scrypt — biçim: `scrypt$N$r$p$salt_b64$hash_b64` (bkz. lib/auth/password.ts)
  passwordHash String @map("password_hash")

  /// Admin geçici parola verdiği için ilk giriş zorunlu değişimle biter.
  mustChangePassword Boolean @default(true) @map("must_change_password")

  role   UserRole
  status UserStatus @default(ACTIVE)

  fullName String? @map("full_name")
  /// Parola bu numaradan iletiliyor — panelde kritik alan.
  phone    String?

  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")

  /// Hangi admin açtı. Admin silinse bile kullanıcı kaydı ayakta kalsın.
  createdById  String? @map("created_by_id")
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions                      Session[]
  studentProfile                StudentProfile?
  teacherProfile                TeacherProfile?
  parentStudents                ParentStudent[]            @relation("ParentLinks")
  taughtGroups                  Group[]                    @relation("GroupTeacher")
  taughtLessons                 Lesson[]                   @relation("LessonTeacher")
  createdAssignments            Assignment[]               @relation("AssignmentCreator")
  notifications                 Notification[]
  notificationPrefs             NotificationPreference?
  createdMaterials              LearningMaterial[]         @relation("MaterialCreator")
  noteTemplates                 TeacherNoteTemplate[]      @relation("TeacherNoteTemplateOwner")
  createdCurriculums            CurriculumVersion[]        @relation("CurriculumCreator")
  linkedLessonOutcomes          LessonOutcome[]            @relation("LessonOutcomeLinker")
  linkedAssignmentOutcomes      AssignmentOutcome[]        @relation("AssignmentOutcomeLinker")
  outcomeFavorites              OutcomeFavorite[]
  createdMockExams              MockExam[]                 @relation("MockExamCreator")
  reviewedMockExams             MockExam[]                 @relation("MockExamReviewer")
  revisedMockExamReasons        MockExamSectionError[]     @relation("MockExamErrorReviser")
  createdReviewItems            ReviewItem[]               @relation("ReviewItemCreator")
  ownedInterventionCases        InterventionCase[]         @relation("InterventionCaseOwner")
  interventionActivities        InterventionCaseActivity[]
  generatedRecoveryPackages     RecoveryPackage[]          @relation("RecoveryPackageGenerator")
  publishedRecoveryPackages     RecoveryPackage[]          @relation("RecoveryPackagePublisher")
  reviewedAssignmentSubmissions AssignmentSubmission[]     @relation("AssignmentSubmissionReviewer")
  studentHelpResponses          StudentHelpResponse[]      @relation("StudentHelpResponder")
  accessibilityPreference       AccessibilityPreference?   @relation("AccessibilityPreferenceOwner")
  updatedAccessibilityProfiles  AccessibilityPreference[]  @relation("AccessibilityPreferenceUpdater")
  networkPreference             NetworkPreference?
  teacherAiDrafts               TeacherAiDraft[]           @relation("TeacherAiDraftOwner")
  createdPilotCohorts           PilotCohort[]              @relation("PilotCohortCreator")
  pilotMemberships              PilotCohortMember[]
  createdOdkPilotRuns           OdkPilotRun[]              @relation("OdkPilotRunCreator")
  odkPilotMemberships           OdkPilotMember[]
  odOrders                      OdOrder[]
  productMemberships            ProductMembership[]        @relation("ProductMembershipOwner")
  grantedProductMemberships     ProductMembership[]        @relation("ProductMembershipGranter")
  createdOdkExamSeries          OdkExamSeries[]            @relation("OdkExamSeriesCreator")
  createdOdkExams               OdkExam[]                  @relation("OdkExamCreator")
  createdOdkExamVersions        OdkExamVersion[]           @relation("OdkExamVersionCreator")
  uploadedOdkExamFiles          OdkExamFile[]              @relation("OdkExamFileUploader")
  odkExamAttempts               OdkExamAttempt[]           @relation("OdkExamAttemptStudent")
  scoredOdkExamAttempts         OdkAttemptScore[]          @relation("OdkAttemptScoreAdmin")
  businessRoleAssignments       BusinessRoleAssignment[]

  @@index([role, status])
  @@index([createdById])
  @@map("users")
}

// ============================================================
// İŞLETME MERKEZİ — Instagram CRM, reklam ve değişmez finans defteri
// Eğitim rolleriyle bilinçli olarak ayrıdır; yetki iş birimi kapsamında verilir.
// ============================================================

enum BusinessRole {
  SUPER_ADMIN
  ADMIN
  SALES
  SUPPORT
  ACCOUNTING
  VIEWER
}

enum IntegrationProvider {
  INSTAGRAM
  META_ADS
  OPENAI
  ACCOUNTING
  EMAIL
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  DEGRADED
  ERROR
}

enum AiMode {
  OFF
  SUGGESTION
  AUTO_SAFE
  AUTO
}

enum ConversationStatus {
  OPEN
  WAITING_HUMAN
  CLOSED
  SPAM
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_PLANNED
  TRIAL_PLANNED
  OFFER_SENT
  PAYMENT_PENDING
  WON
  LOST
  SPAM
}

enum LeadSource {
  INSTAGRAM_ORGANIC
  INSTAGRAM_AD
  OD_WEB_FORM
  ODK_WEB_FORM
  PURCHASE_STARTED
  PURCHASE_COMPLETED
  MANUAL
  OTHER
}

enum ProductInterest {
  ONLINE_DERSHANEM
  ONLINE_DENEME_KULUBU
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum FinancialSource {
  ONLINE_DERSHANEM
  ONLINE_DENEME_KULUBU
  MANUAL
  OTHER
}

enum FinancialKind {
  SALE
  RENEWAL
  ADDITIONAL_PAYMENT
  MANUAL_INCOME
  ADJUSTMENT
  REFUND_REVERSAL
  EXPENSE
  REVERSAL
}

enum FinancialStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  FAILED
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
}

enum ReconciliationStatus {
  MATCHED
  UNMATCHED
  MANUALLY_MATCHED
  REVIEW_REQUIRED
  CORRECTED
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

model BusinessUnit {
  id                    String                   @id @default(cuid())
  code                  String                   @unique
  name                  String
  product               ProductCode              @unique
  isActive              Boolean                  @default(true) @map("is_active")
  retentionDays         Int                      @default(730) @map("retention_days")
  settings              Json?
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  roles                 BusinessRoleAssignment[]
  integrations          IntegrationConnection[]
  instagramAccounts     InstagramAccount[]
  conversations         BusinessConversation[]
  leads                 BusinessLead[]
  campaigns             BusinessCampaign[]
  knowledgeEntries      KnowledgeBaseEntry[]
  automationRules       AutomationRule[]
  financialTransactions FinancialTransaction[]
  expenseCategories     ExpenseCategory[]
  taxProfiles           TaxProfile[]
  accountingPeriods     AccountingPeriod[]
  reconciliationRecords ReconciliationRecord[]
  backgroundJobs        BackgroundJob[]
  aiPromptVersions      AIPromptVersion[]

  @@map("business_units")
}

model BusinessRoleAssignment {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  businessUnitId String       @map("business_unit_id")
  role           BusinessRole
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([userId, businessUnitId, role])
  @@index([businessUnitId, role])
  @@map("business_role_assignments")
}

model IntegrationConnection {
  id                   String              @id @default(cuid())
  businessUnitId       String              @map("business_unit_id")
  provider             IntegrationProvider
  status               IntegrationStatus   @default(DISCONNECTED)
  displayName          String              @map("display_name")
  config               Json?
  encryptedCredentials String?             @map("encrypted_credentials")
  lastHealthAt         DateTime?           @map("last_health_at")
  lastErrorCode        String?             @map("last_error_code")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  businessUnit         BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  instagramAccounts    InstagramAccount[]

  @@unique([businessUnitId, provider, displayName])
  @@index([provider, status])
  @@map("integration_connections")
}

model InstagramAccount {
  id             String                  @id @default(cuid())
  businessUnitId String                  @map("business_unit_id")
  connectionId   String                  @map("connection_id")
  externalId     String                  @unique @map("external_id")
  username       String?
  aiMode         AiMode                  @default(SUGGESTION) @map("ai_mode")
  isActive       Boolean                 @default(true) @map("is_active")
  tokenExpiresAt DateTime?               @map("token_expires_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  businessUnit   BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  webhookEvents  InstagramWebhookEvent[]
  conversations  BusinessConversation[]

  @@index([businessUnitId, isActive])
  @@map("instagram_accounts")
}

model InstagramWebhookEvent {
  id                 String            @id @default(cuid())
  instagramAccountId String?           @map("instagram_account_id")
  providerEventId    String            @unique @map("provider_event_id")
  idempotencyKey     String            @unique @map("idempotency_key")
  eventType          String            @map("event_type")
  occurredAt         DateTime          @map("occurred_at")
  payload            Json
  processedAt        DateTime?         @map("processed_at")
  errorCode          String?           @map("error_code")
  retryCount         Int               @default(0) @map("retry_count")
  createdAt          DateTime          @default(now()) @map("created_at")
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([processedAt, createdAt])
  @@map("instagram_webhook_events")
}

model BusinessConversation {
  id                    String             @id @default(cuid())
  businessUnitId        String             @map("business_unit_id")
  instagramAccountId    String             @map("instagram_account_id")
  instagramScopedUserId String             @map("instagram_scoped_user_id")
  username              String?
  displayName           String?            @map("display_name")
  profilePictureUrl     String?            @map("profile_picture_url")
  status                ConversationStatus @default(OPEN)
  temperature           LeadTemperature    @default(COLD)
  aiMode                AiMode             @default(SUGGESTION) @map("ai_mode")
  assignedUserId        String?            @map("assigned_user_id")
  tags                  String[]
  productInterest       ProductInterest    @default(UNKNOWN) @map("product_interest")
  unreadCount           Int                @default(0) @map("unread_count")
  lastMessageAt         DateTime           @default(now()) @map("last_message_at")
  lastReplyBy           MessageSenderType? @map("last_reply_by")
  summary               String?
  sourceCampaignExternalId String?          @map("source_campaign_external_id")
  sourceAdExternalId       String?          @map("source_ad_external_id")
  anonymizedAt          DateTime?           @map("anonymized_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  businessUnit          BusinessUnit       @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  instagramAccount      InstagramAccount   @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  messages              BusinessMessage[]
  lead                  BusinessLead?
  aiExecutions          AIExecution[]

  @@unique([instagramAccountId, instagramScopedUserId])
  @@index([businessUnitId, status, lastMessageAt])
  @@index([assignedUserId, status])
  @@map("business_conversations")
}

model BusinessMessage {
  id               String               @id @default(cuid())
  conversationId   String               @map("conversation_id")
  externalId       String?              @unique @map("external_id")
  direction        MessageDirection
  senderType       MessageSenderType    @map("sender_type")
  type             String               @default("TEXT")
  body             String?
  mediaMetadata    Json?                @map("media_metadata")
  providerMetadata Json?                @map("provider_metadata")
  status           MessageStatus
  failureCode      String?              @map("failure_code")
  idempotencyKey   String               @unique @map("idempotency_key")
  occurredAt       DateTime             @map("occurred_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  conversation     BusinessConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries       MessageDelivery[]

  @@index([conversationId, occurredAt])
  @@index([status, createdAt])
  @@map("business_messages")
}

model MessageDelivery {
  id               String          @id @default(cuid())
  messageId        String          @map("message_id")
  status           MessageStatus
  providerResponse Json?           @map("provider_response")
  attemptedAt      DateTime        @default(now()) @map("attempted_at")
  message          BusinessMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, attemptedAt])
  @@map("message_deliveries")
}

model BusinessLead {
  id                    String                 @id @default(cuid())
  businessUnitId        String                 @map("business_unit_id")
  conversationId        String?                @unique @map("conversation_id")
  firstName             String?                @map("first_name")
  lastName              String?                @map("last_name")
  instagramScopedId     String?                @map("instagram_scoped_id")
  phone                 String?
  normalizedPhone       String?                @map("normalized_phone")
  email                 String?
  normalizedEmail       String?                @map("normalized_email")
  studentName           String?                @map("student_name")
  parentName            String?                @map("parent_name")
  grade                 String?
  examType              String?                @map("exam_type")
  city                  String?
  productInterest       ProductInterest        @default(UNKNOWN) @map("product_interest")
  source                LeadSource
  stage                 LeadStage              @default(NEW)
  temperature           LeadTemperature        @default(COLD)
  assignedUserId        String?                @map("assigned_user_id")
  estimatedValueCents   Int?                   @map("estimated_value_cents")
  tags                  String[]
  consentMetadata       Json?                  @map("consent_metadata")
  lostReason            String?                @map("lost_reason")
  relatedOdUserId       String?                @map("related_od_user_id")
  relatedOdkUserId      String?                @map("related_odk_user_id")
  relatedOdOrderId      String?                @map("related_od_order_id")
  relatedOdkOrderId     String?                @map("related_odk_order_id")
  matchSuggestion      Json?                  @map("match_suggestion")
  anonymizedAt          DateTime?              @map("anonymized_at")
  firstContactAt        DateTime               @default(now()) @map("first_contact_at")
  lastContactAt         DateTime               @default(now()) @map("last_contact_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  businessUnit          BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  conversation          BusinessConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  activities            LeadActivity[]
  tasks                 LeadTask[]
  attributions          Attribution[]
  financialTransactions FinancialTransaction[]

  @@index([businessUnitId, stage, updatedAt])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([instagramScopedId])
  @@map("business_leads")
}

model LeadActivity {
  id          String       @id @default(cuid())
  leadId      String       @map("lead_id")
  type        String
  fromValue   String?      @map("from_value")
  toValue     String?      @map("to_value")
  actorUserId String?      @map("actor_user_id")
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  lead        BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model LeadTask {
  id             String       @id @default(cuid())
  leadId         String       @map("lead_id")
  title          String
  dueAt          DateTime?    @map("due_at")
  assignedUserId String?      @map("assigned_user_id")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  lead           BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([assignedUserId, completedAt, dueAt])
  @@map("lead_tasks")
}

model BusinessCampaign {
  id                    String                 @id @default(cuid())
  businessUnitId        String                 @map("business_unit_id")
  externalId            String?                @map("external_id")
  name                  String
  platform              String                 @default("INSTAGRAM")
  objective             String?
  productInterest       ProductInterest        @default(UNKNOWN) @map("product_interest")
  startsAt              DateTime?              @map("starts_at")
  endsAt                DateTime?              @map("ends_at")
  budgetCents           Int                    @default(0) @map("budget_cents")
  spentCents            Int                    @default(0) @map("spent_cents")
  status                CampaignStatus         @default(DRAFT)
  utm                   Json?
  description           String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  businessUnit          BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  adSets                BusinessAdSet[]
  attributions          Attribution[]
  financialTransactions FinancialTransaction[]

  @@unique([businessUnitId, platform, externalId])
  @@index([businessUnitId, status, startsAt])
  @@map("business_campaigns")
}

model BusinessAdSet {
  id                  String                  @id @default(cuid())
  campaignId          String                  @map("campaign_id")
  externalId          String?                 @map("external_id")
  name                String
  audienceDescription String?                 @map("audience_description")
  budgetCents         Int                     @default(0) @map("budget_cents")
  status              CampaignStatus          @default(DRAFT)
  campaign            BusinessCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertisements      BusinessAdvertisement[]

  @@unique([campaignId, externalId])
  @@map("business_ad_sets")
}

model BusinessAdvertisement {
  id             String        @id @default(cuid())
  adSetId        String        @map("ad_set_id")
  externalId     String?       @map("external_id")
  name           String
  creativeName   String?       @map("creative_name")
  openingMessage String?       @map("opening_message")
  spentCents     Int           @default(0) @map("spent_cents")
  impressions    Int           @default(0)
  reach          Int           @default(0)
  clicks         Int           @default(0)
  messageStarts  Int           @default(0) @map("message_starts")
  leadCount      Int           @default(0) @map("lead_count")
  saleCount      Int           @default(0) @map("sale_count")
  revenueCents   Int           @default(0) @map("revenue_cents")
  adSet          BusinessAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  attributions   Attribution[]

  @@unique([adSetId, externalId])
  @@map("business_advertisements")
}

model Attribution {
  id              String                 @id @default(cuid())
  leadId          String                 @map("lead_id")
  campaignId      String?                @map("campaign_id")
  advertisementId String?                @map("advertisement_id")
  model           String
  confidence      Decimal                @db.Decimal(5, 4)
  isManual        Boolean                @default(false) @map("is_manual")
  createdAt       DateTime               @default(now()) @map("created_at")
  lead            BusinessLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign        BusinessCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  advertisement   BusinessAdvertisement? @relation(fields: [advertisementId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("attributions")
}

model KnowledgeBaseEntry {
  id              String          @id @default(cuid())
  businessUnitId  String          @map("business_unit_id")
  title           String
  content         String
  category        String
  productInterest ProductInterest @default(UNKNOWN) @map("product_interest")
  isActive        Boolean         @default(true) @map("is_active")
  validFrom       DateTime?       @map("valid_from")
  validUntil      DateTime?       @map("valid_until")
  version         Int             @default(1)
  source          String?
  updatedById     String?         @map("updated_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  businessUnit    BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@index([businessUnitId, isActive, category])
  @@map("knowledge_base_entries")
}

model AIPromptVersion {
  id            String   @id @default(cuid())
  businessUnitId String? @map("business_unit_id")
  name          String
  version       Int
  systemPrompt  String   @map("system_prompt")
  schemaVersion Int      @default(1) @map("schema_version")
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  businessUnit  BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([name, version])
