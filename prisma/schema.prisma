/**
 * Ürün erişimi (yetki) kodları — üç ticari ürün.
 *
 * DİKKAT: bu enum YALNIZCA yetki tarafındadır (`ProductMembership`,
 * `BusinessUnit`). Sipariş/ödeme tarafı ayrı `CommerceProduct` enum'unu
 * kullanır; oraya OK eklenmedi çünkü Koçum'un henüz satış/provisioning akışı
 * yok. İkisini birleştirme — finans kodundaki `product === "OD" ? ... : ...`
 * ikili dalları CommerceProduct'a bakar ve üçüncü değer görürse Koçum'u
 * sessizce ODK sayardı.
 */
enum ProductCode {
  OD
  /** Online Koçum */
  OK
  ODK
}

