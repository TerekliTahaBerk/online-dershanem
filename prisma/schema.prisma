}

model RecoveryPackageItem {
  id           String            @id @default(cuid())
  packageId    String            @map("package_id")
  kind         RecoveryItemKind
  position     Int
  title        String
  materialId   String?           @map("material_id")
  assignmentId String?           @map("assignment_id")
  completedAt  DateTime?         @map("completed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  package      RecoveryPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  material     LearningMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  assignment   Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([packageId, position])
  @@index([materialId])
  @@index([assignmentId])
  @@map("recovery_package_items")
}

model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// Çerezdeki opak token'ın sha256'sı. Düz token ASLA saklanmaz —
  /// DB sızarsa oturumlar ele geçirilemesin.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  userAgent String? @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

