generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PANEL — kimlik çekirdeği
//
// Public self-register YOKTUR: hesabı yalnızca ADMIN açar ve geçici parolayı
// elden (WhatsApp/telefon) iletir. Bu yüzden e-posta gönderimine bağlı hiçbir
// akış yok — parola sıfırlama da admin eliyle yapılır.
// ============================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id String @id @default(cuid())

  /// DAİMA locale'siz küçük harf. `toLocaleLowerCase("tr")` KULLANMA:
  /// Türkçe locale'de "I" → "ı" olur ve e-postayı kalıcı olarak bozar.
  email String @unique

  /// scrypt — biçim: `scrypt$N$r$p$salt_b64$hash_b64` (bkz. lib/auth/password.ts)
  passwordHash String @map("password_hash")

  /// Admin geçici parola verdiği için ilk giriş zorunlu değişimle biter.
  mustChangePassword Boolean @default(true) @map("must_change_password")

  role   UserRole
  status UserStatus @default(ACTIVE)

  fullName String? @map("full_name")
  /// Parola bu numaradan iletiliyor — panelde kritik alan.
  phone    String?

  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")

  /// Hangi admin açtı. Admin silinse bile kullanıcı kaydı ayakta kalsın.
  createdById  String? @map("created_by_id")
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  parentStudents     ParentStudent[] @relation("ParentLinks")
  taughtGroups       Group[]         @relation("GroupTeacher")
  taughtLessons      Lesson[]        @relation("LessonTeacher")
  createdAssignments Assignment[]    @relation("AssignmentCreator")
  odOrders           OdOrder[]

  @@index([role, status])
  @@index([createdById])
  @@map("users")
}

enum LessonStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model StudentProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique @map("user_id")
  classLevel         String?              @map("class_level")
  schoolName         String?              @map("school_name")
  targetGoal         String?              @map("target_goal")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents            ParentStudent[]
  enrollments        Enrollment[]
  notes              LessonNote[]
  attendances        Attendance[]
  assignmentProgress AssignmentProgress[]

  @@map("student_profiles")
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  subjects  String[] @default([])
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model ParentStudent {
  id           String         @id @default(cuid())
  parentId     String         @map("parent_id")
  studentId    String         @map("student_id")
  relationship String?
  createdAt    DateTime       @default(now()) @map("created_at")
  parent       User           @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

model Group {
  id          String       @id @default(cuid())
  name        String
  subject     String
  level       String?
  capacity    Int          @default(4)
  teacherId   String       @map("teacher_id")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  teacher     User         @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  lessons     Lesson[]
  assignments Assignment[]

  @@index([teacherId, isActive])
  @@map("groups")
}

model Enrollment {
  id        String         @id @default(cuid())
  groupId   String         @map("group_id")
  studentId String         @map("student_id")
  startedAt DateTime       @default(now()) @map("started_at")
  endedAt   DateTime?      @map("ended_at")
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId, endedAt])
  @@map("enrollments")
}

model Lesson {
  id          String       @id @default(cuid())
  groupId     String       @map("group_id")
  teacherId   String       @map("teacher_id")
  title       String
  startsAt    DateTime     @map("starts_at")
  endsAt      DateTime     @map("ends_at")
  status      LessonStatus @default(PLANNED)
  meetingUrl  String?      @map("meeting_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     User         @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  notes       LessonNote[]
  attendances Attendance[]
  assignments Assignment[]

  @@index([teacherId, startsAt])
  @@index([groupId, startsAt])
  @@map("lessons")
}

model LessonNote {
  id        String          @id @default(cuid())
  lessonId  String          @map("lesson_id")
  studentId String?         @map("student_id")
  topic     String?
  note      String?
  nextGoal  String?         @map("next_goal")
  homework  String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([studentId, updatedAt])
  @@map("lesson_notes")
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String           @map("lesson_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, createdAt])
  @@map("attendances")
}

enum AssignmentProgressStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Assignment {
  id          String               @id @default(cuid())
  groupId     String               @map("group_id")
  lessonId    String?              @map("lesson_id")
  createdById String               @map("created_by_id")
  title       String
  description String?
  dueAt       DateTime             @map("due_at")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson      Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  progress    AssignmentProgress[]

  @@index([groupId, dueAt])
  @@index([createdById, isActive])
  @@map("assignments")
}

model AssignmentProgress {
  id           String                   @id @default(cuid())
  assignmentId String                   @map("assignment_id")
  studentId    String                   @map("student_id")
  status       AssignmentProgressStatus @default(TODO)
  completedAt  DateTime?                @map("completed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  assignment   Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, status, updatedAt])
  @@map("assignment_progress")
}

model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// Çerezdeki opak token'ın sha256'sı. Düz token ASLA saklanmaz —
  /// DB sızarsa oturumlar ele geçirilemesin.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  userAgent String? @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

enum IntakeStatus {
  NEW
  REVIEWING
  CONTACTED
  ENROLLED
  ARCHIVED
}

enum PurchaseEventType {
  FORM_SUBMITTED
  PAYMENT_LINK_OPENED
  CALLBACK_RECEIVED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
  ABANDONED
}

enum AuditActorType {
  SYSTEM
  USER
}

enum PackageType {
  COURSE
  EXAM
}

enum OdkOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum OdkPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OdkPaymentProvider {
  MANUAL
  IYZICO
  BANK_TRANSFER
  PAYTR
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponService {
  OD
  ODK
  ALL
}

model EmailOutbox {
  id          String            @id @default(cuid())
  recipients  String
  subject     String
  html        String
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  sentAt      DateTime?         @map("sent_at")
  nextRetryAt DateTime?         @map("next_retry_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@map("email_outbox")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model LeadSubmission {
  id           String       @id @default(cuid())
  fullName     String
  phone        String
  classLevel   String
  examType     String
  targetGoal   String
  currentNet   String
  parentPhone  String?
  kvkkConsent  Boolean
  source       String
  intakeStatus IntakeStatus @default(NEW)
  adminNotes   String?
  taskLabel    String?
  nextActionAt DateTime?
  submittedAt  DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([intakeStatus, submittedAt])
}

model PurchaseIntent {
  id               String          @id @default(cuid())
  source           String
  packageName      String
  paymentLink      String?
  studentFullName  String
  studentPhone     String
  studentEmail     String
  schoolName       String
  city             String
  district         String
  classLevel       String
  department       String?
  examType         String
  targetSchool     String?
  targetRanking    String
  currentLevel     String
  currentNet       String
  weakLessons      String
  strongLessons    String?
  needType         String
  studyStatus      String
  weeklyStudyHours String
  parentFullName   String?
  parentPhone      String?
  parentEmail      String?
  notes            String?
  kvkkConsent      Boolean
  paymentConsent   Boolean
  status           PurchaseStatus  @default(PENDING)
  intakeStatus     IntakeStatus    @default(NEW)
  adminNotes       String?
  taskLabel        String?
  nextActionAt     DateTime?
  submittedAt      DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           PurchaseEvent[]

  @@index([intakeStatus, submittedAt])
}

model PurchaseEvent {
  id                String            @id @default(cuid())
  purchaseIntentId  String
  eventType         PurchaseEventType
  status            PurchaseStatus
  source            String
  packageName       String
  paymentLink       String?
  provider          String?
  providerReference String?
  payload           Json?
  createdAt         DateTime          @default(now())
  purchaseIntent    PurchaseIntent    @relation(fields: [purchaseIntentId], references: [id], onDelete: Cascade)

  @@index([purchaseIntentId, createdAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorUserId String?
  actorType   AuditActorType @default(SYSTEM)
  entityType  String
  entityId    String
  action      String
  summary     String?
  payload     Json?
  createdAt   DateTime       @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model Package {
  id          String      @id @default(cuid())
  name        String
  type        PackageType @default(COURSE)
  description String?
  price       Int
  paytrLink   String?
  lessonCount Int
  subjects    String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  odOrders    OdOrder[]

  @@index([isActive])
  @@index([type, isActive])
}

model OdkPackage {
  id                 String     @id @default(cuid())
  title              String
  slug               String     @unique
  description        String?
  priceCents         Int        @map("price_cents")
  originalPriceCents Int?       @map("original_price_cents")
  durationDays       Int?       @map("duration_days")
  isActive           Boolean    @default(true) @map("is_active")
  isFeatured         Boolean    @default(false) @map("is_featured")
  ctaText            String?    @map("cta_text")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  orders             OdkOrder[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("odk_packages")
}

model OdkOrder {
  id            String         @id @default(cuid())
  packageId     String         @map("package_id")
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  package       OdkPackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments      OdkPayment[]

  @@index([status, createdAt])
  @@map("odk_orders")
}

model OdkPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(MANUAL)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdkOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("odk_payments")
}

model OdOrder {
  id            String         @id @default(cuid())
  packageId     String?        @map("package_id")
  packageName   String         @map("package_name")
  category      String?
  subject       String?
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  intentId      String?        @map("intent_id")
  userId        String?        @map("user_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments      OdPayment[]
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([intentId])
  @@index([userId, createdAt])
  @@map("od_orders")
}

model OdPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(PAYTR)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("od_payments")
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             CouponType         @default(PERCENT)
  service          CouponService      @default(ALL)
  value            Int
  minOrderCents    Int                @default(0) @map("min_order_cents")
  maxDiscountCents Int                @default(0) @map("max_discount_cents")
  usageLimit       Int                @default(0) @map("usage_limit")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  startsAt         DateTime?          @map("starts_at")
  expiresAt        DateTime?          @map("expires_at")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  redemptions      CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String   @map("coupon_id")
  customerKey   String   @map("customer_key")
  orderService  String   @map("order_service")
  orderId       String   @map("order_id")
  discountCents Int      @map("discount_cents")
  redeemedAt    DateTime @default(now()) @map("redeemed_at")
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerKey])
  @@index([orderService, orderId])
  @@map("coupon_redemptions")
}
