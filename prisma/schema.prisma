model CurriculumSubject {
  id        String            @id @default(cuid())
  versionId String            @map("version_id")
  code      String
  name      String
  position  Int               @default(0)
  version   CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  units     CurriculumUnit[]

  @@unique([versionId, code])
  @@index([versionId, position])
  @@map("curriculum_subjects")
}

model CurriculumUnit {
  id        String            @id @default(cuid())
  subjectId String            @map("subject_id")
  code      String
  name      String
  position  Int               @default(0)
  subject   CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  outcomes  LearningOutcome[]

  @@unique([subjectId, code])
  @@index([subjectId, position])
  @@map("curriculum_units")
}

model CurriculumSkill {
  id        String            @id @default(cuid())
  versionId String            @map("version_id")
  code      String
  name      String
  version   CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  outcomes  OutcomeSkill[]

  @@unique([versionId, code])
  @@map("curriculum_skills")
}

model LearningOutcome {
  id               String                   @id @default(cuid())
  unitId           String                   @map("unit_id")
  code             String
  title            String
  description      String?
  isActive         Boolean                  @default(true) @map("is_active")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  unit             CurriculumUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skills           OutcomeSkill[]
  lessons          LessonOutcome[]
  assignments      AssignmentOutcome[]
  favorites        OutcomeFavorite[]
  reviewItems      ReviewItem[]
  odkQuestions     OdkQuestionOutcome[]
  odkAttemptScores OdkAttemptOutcomeScore[]

  @@unique([unitId, code])
  @@index([isActive, updatedAt])
  @@map("learning_outcomes")
}

model OutcomeSkill {
  outcomeId String          @map("outcome_id")
  skillId   String          @map("skill_id")
  outcome   LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  skill     CurriculumSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([outcomeId, skillId])
  @@map("outcome_skills")
}

model LessonOutcome {
  lessonId     String              @map("lesson_id")
  outcomeId    String              @map("outcome_id")
  evidenceType OutcomeEvidenceType @default(TAUGHT) @map("evidence_type")
  linkedById   String              @map("linked_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  lesson       Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  outcome      LearningOutcome     @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  linkedBy     User                @relation("LessonOutcomeLinker", fields: [linkedById], references: [id], onDelete: Restrict)

  @@id([lessonId, outcomeId])
  @@index([outcomeId, evidenceType, createdAt])
  @@map("lesson_outcomes")
}

model AssignmentOutcome {
  assignmentId String          @map("assignment_id")
  outcomeId    String          @map("outcome_id")
  linkedById   String          @map("linked_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  outcome      LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  linkedBy     User            @relation("AssignmentOutcomeLinker", fields: [linkedById], references: [id], onDelete: Restrict)

  @@id([assignmentId, outcomeId])
  @@index([outcomeId, createdAt])
  @@map("assignment_outcomes")
}

model OutcomeFavorite {
  userId    String          @map("user_id")
  outcomeId String          @map("outcome_id")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome   LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@id([userId, outcomeId])
  @@index([userId, createdAt])
  @@map("outcome_favorites")
}

model MockExam {
  id                   String            @id @default(cuid())
  studentId            String            @map("student_id")
  exam                 CurriculumExam
  title                String?
  publisher            String?
  takenAt              DateTime          @map("taken_at")
  durationMinutes      Int?              @map("duration_minutes")
  nextAction           String?           @map("next_action")
  nextActionApprovedAt DateTime?         @map("next_action_approved_at")
  createdById          String            @map("created_by_id")
  reviewedById         String?           @map("reviewed_by_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  student              StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy            User              @relation("MockExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy           User?             @relation("MockExamReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  sections             MockExamSection[]

  @@index([studentId, takenAt])
  @@index([exam, takenAt])
  @@map("mock_exams")
}

model MockExamSection {
  id              String                 @id @default(cuid())
  mockExamId      String                 @map("mock_exam_id")
  subjectCode     String                 @map("subject_code")
  subjectName     String                 @map("subject_name")
  questionCount   Int                    @map("question_count")
  correctCount    Int                    @map("correct_count")
  incorrectCount  Int                    @map("incorrect_count")
  blankCount      Int                    @map("blank_count")
  durationMinutes Int?                   @map("duration_minutes")
  position        Int                    @default(0)
  mockExam        MockExam               @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  errors          MockExamSectionError[]
  reviewItems     ReviewItem[]

  @@unique([mockExamId, subjectCode])
  @@index([mockExamId, position])
  @@map("mock_exam_sections")
}

model MockExamSectionError {
  sectionId   String                @map("section_id")
  category    MockExamErrorCategory
  revisedById String?               @map("revised_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  section     MockExamSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  revisedBy   User?                 @relation("MockExamErrorReviser", fields: [revisedById], references: [id], onDelete: SetNull)

  @@id([sectionId, category])
  @@index([category, updatedAt])
  @@map("mock_exam_section_errors")
}

model ReviewItem {
  id                String           @id @default(cuid())
  studentId         String           @map("student_id")
  sourceType        ReviewSourceType @map("source_type")
  mockExamSectionId String?          @unique @map("mock_exam_section_id")
  lessonId          String?          @map("lesson_id")
  outcomeId         String?          @map("outcome_id")
  createdById       String?          @map("created_by_id")
  title             String
  sourceReference   String           @map("source_reference")
  solutionNote      String?          @map("solution_note")
  stage             Int              @default(0)
  dueAt             DateTime         @map("due_at")
  lastReviewedAt    DateTime?        @map("last_reviewed_at")
  lastDeferredOn    DateTime?        @map("last_deferred_on")
  status            ReviewItemStatus @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockExamSection   MockExamSection? @relation(fields: [mockExamSectionId], references: [id], onDelete: Cascade)
  lesson            Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  outcome           LearningOutcome? @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  createdBy         User?            @relation("ReviewItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attempts          ReviewAttempt[]

  @@unique([studentId, lessonId, outcomeId])
  @@index([studentId, status, dueAt])
  @@index([createdById, status])
  @@map("review_items")
}

model ReviewAttempt {
  id             String         @id @default(cuid())
  reviewItemId   String         @map("review_item_id")
  response       ReviewResponse
  stageBefore    Int            @map("stage_before")
  stageAfter     Int            @map("stage_after")
  nextDueAt      DateTime?      @map("next_due_at")
  idempotencyKey String         @map("idempotency_key")
  reviewedAt     DateTime       @default(now()) @map("reviewed_at")
  reviewItem     ReviewItem     @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@unique([reviewItemId, idempotencyKey])
  @@index([reviewedAt, response])
  @@map("review_attempts")
}

model Package {
  id          String      @id @default(cuid())
  name        String
  type        PackageType @default(COURSE)
  description String?
  price       Int
  paytrLink   String?
  lessonCount Int
  subjects    String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  odOrders    OdOrder[]

  @@index([isActive])
  @@index([type, isActive])
}

model OdkPackage {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  description        String?
  priceCents         Int              @map("price_cents")
  originalPriceCents Int?             @map("original_price_cents")
  durationDays       Int?             @map("duration_days")
  isActive           Boolean          @default(true) @map("is_active")
  isFeatured         Boolean          @default(false) @map("is_featured")
  ctaText            String?          @map("cta_text")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  orders             OdkOrder[]
  examLinks          OdkPackageExam[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("odk_packages")
}

/// Aynı sınav ailesinde tekrar eden matematik denemelerini gruplar.
model OdkExamSeries {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  family       OdkExamFamily
  academicYear Int           @map("academic_year")
  classLevel   String?       @map("class_level")
  isActive     Boolean       @default(true) @map("is_active")
  createdById  String        @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  createdBy    User          @relation("OdkExamSeriesCreator", fields: [createdById], references: [id], onDelete: Restrict)
  exams        OdkExam[]

  @@index([family, academicYear, isActive])
  @@index([createdById, createdAt])
  @@map("odk_exam_series")
}

/// Takvim ve yayın yaşam döngüsü. Soru içeriği sürümlerde dondurulur.
model OdkExam {
  id                  String           @id @default(cuid())
  seriesId            String?          @map("series_id")
  title               String
  slug                String           @unique
  family              OdkExamFamily
  status              OdkExamStatus    @default(DRAFT)
  currentVersionId    String?          @unique @map("current_version_id")
  startsAt            DateTime?        @map("starts_at")
  endsAt              DateTime?        @map("ends_at")
  lateEntryMinutes    Int              @default(0) @map("late_entry_minutes")
  attemptLimit        Int              @default(1) @map("attempt_limit")
  meetRequired        Boolean          @default(true) @map("meet_required")
  meetUrl             String?          @map("meet_url")
  answerKeyReleasedAt DateTime?        @map("answer_key_released_at")
  resultsReleasedAt   DateTime?        @map("results_released_at")
  publishedAt         DateTime?        @map("published_at")
  createdById         String           @map("created_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  series              OdkExamSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdBy           User             @relation("OdkExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion      OdkExamVersion?  @relation("OdkCurrentExamVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions            OdkExamVersion[] @relation("OdkExamVersions")
  packageLinks        OdkPackageExam[]
  attempts            OdkExamAttempt[]

  @@index([family, status, startsAt])
  @@index([seriesId, startsAt])
  @@index([status, startsAt, endsAt])
  @@map("odk_exams")
}

/// Yayına alınan sürüm kilitlenir; daha sonraki düzeltme yeni sürüm oluşturur.
model OdkExamVersion {
  id              String               @id @default(cuid())
  examId          String               @map("exam_id")
  versionNumber   Int                  @map("version_number")
  status          OdkExamVersionStatus @default(DRAFT)
  durationMinutes Int                  @map("duration_minutes")
  instructions    String?
  scoringPolicyId String               @map("scoring_policy_id")
  createdById     String               @map("created_by_id")
  lockedAt        DateTime?            @map("locked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  exam            OdkExam              @relation("OdkExamVersions", fields: [examId], references: [id], onDelete: Cascade)
  currentForExam  OdkExam?             @relation("OdkCurrentExamVersion")
  scoringPolicy   OdkScoringPolicy     @relation(fields: [scoringPolicyId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation("OdkExamVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections        OdkExamSection[]
  files           OdkExamFile[]
  attempts        OdkExamAttempt[]

  @@unique([examId, versionNumber])
  @@index([examId, status])
  @@index([createdById, createdAt])
  @@map("odk_exam_versions")
}

model OdkScoringPolicy {
  id               String           @id @default(cuid())
  code             String           @unique
  title            String
  wrongPenalty     Decimal          @map("wrong_penalty") @db.Decimal(5, 2)
  minimumNetIsZero Boolean          @default(true) @map("minimum_net_is_zero")
  createdAt        DateTime         @default(now()) @map("created_at")
  versions         OdkExamVersion[]

  @@map("odk_scoring_policies")
}

model OdkExamSection {
  id            String            @id @default(cuid())
  versionId     String            @map("version_id")
  code          String
  title         String
  position      Int
  questionCount Int               @map("question_count")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  version       OdkExamVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions     OdkExamQuestion[]

  @@unique([versionId, code])
  @@unique([versionId, position])
  @@index([versionId, position])
  @@map("odk_exam_sections")
}

/// Soru metnini saklamaz; PDF içindeki numara, cevap ve akademik metadata'yı taşır.
model OdkExamQuestion {
  id             String                     @id @default(cuid())
  sectionId      String                     @map("section_id")
  questionNumber Int                        @map("question_number")
  position       Int
  correctOption  OdkAnswerOption?           @map("correct_option")
  difficulty     OdkQuestionDifficulty      @default(MEDIUM)
  bookletPage    Int?                       @map("booklet_page")
  isActive       Boolean                    @default(true) @map("is_active")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  section        OdkExamSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  outcomes       OdkQuestionOutcome[]
  attemptAnswers OdkAttemptAnswer[]
  attemptResults OdkAttemptQuestionResult[]

  @@unique([sectionId, questionNumber])
  @@unique([sectionId, position])
  @@index([sectionId, position])
  @@map("odk_exam_questions")
}

model OdkQuestionOutcome {
  questionId String          @map("question_id")
  outcomeId  String          @map("outcome_id")
  isPrimary  Boolean         @default(false) @map("is_primary")
  question   OdkExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  outcome    LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@id([questionId, outcomeId])
  @@index([outcomeId, questionId])
  @@map("odk_question_outcomes")
}

/// Blob URL'si değil private pathname saklanır; indirme her istekte yetkilendirilir.
model OdkExamFile {
  id           String          @id @default(cuid())
  versionId    String          @map("version_id")
  type         OdkExamFileType
  blobPathname String          @map("blob_pathname")
  fileName     String          @map("file_name")
  mimeType     String          @map("mime_type")
  byteSize     Int             @map("byte_size")
  checksum     String?
  uploadedById String          @map("uploaded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  version      OdkExamVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("OdkExamFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([versionId, type])
  @@index([uploadedById, createdAt])
  @@map("odk_exam_files")
}

model OdkPackageExam {
  packageId String     @map("package_id")
  examId    String     @map("exam_id")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  package   OdkPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  exam      OdkExam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([packageId, examId])
  @@index([examId])
  @@map("odk_package_exams")
}

/// Öğrencinin kilitli sınav sürümüne bağlı, sunucu saatli çözüm oturumu.
model OdkExamAttempt {
  id                 String             @id @default(cuid())
  examId             String             @map("exam_id")
  versionId          String             @map("version_id")
  studentUserId      String             @map("student_user_id")
  attemptNumber      Int                @default(1) @map("attempt_number")
  status             OdkAttemptStatus   @default(IN_PROGRESS)
  meetAcknowledgedAt DateTime?          @map("meet_acknowledged_at")
  startedAt          DateTime           @default(now()) @map("started_at")
  deadlineAt         DateTime           @map("deadline_at")
  submittedAt        DateTime?          @map("submitted_at")
  lastActivityAt     DateTime           @default(now()) @map("last_activity_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  exam               OdkExam            @relation(fields: [examId], references: [id], onDelete: Restrict)
  version            OdkExamVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  student            User               @relation("OdkExamAttemptStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  answers            OdkAttemptAnswer[]
  score              OdkAttemptScore?

  @@unique([examId, studentUserId, attemptNumber])
  @@index([studentUserId, status, deadlineAt])
  @@index([examId, status, startedAt])
  @@map("odk_exam_attempts")
}

/// Cevaplar soru bazında ve artan revizyonla kaydedilir; istemci tekrarları güvenlidir.
model OdkAttemptAnswer {
  attemptId      String           @map("attempt_id")
  questionId     String           @map("question_id")
  selectedOption OdkAnswerOption? @map("selected_option")
  isMarked       Boolean          @default(false) @map("is_marked")
  revision       Int              @default(1)
  answeredAt     DateTime?        @map("answered_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  attempt        OdkExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       OdkExamQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@index([questionId])
  @@map("odk_attempt_answers")
}

/// Kilitli cevap anahtarıyla üretilen, tekrar üretilebilir toplam sonuç.
model OdkAttemptScore {
  attemptId       String                     @id @map("attempt_id")
  correctCount    Int                        @map("correct_count")
  wrongCount      Int                        @map("wrong_count")
  blankCount      Int                        @map("blank_count")
  totalNet        Decimal                    @map("total_net") @db.Decimal(7, 2)
  scoringVersion  String                     @map("scoring_version")
  answerKeyHash   String                     @map("answer_key_hash")
  scoredById      String                     @map("scored_by_id")
  scoredAt        DateTime                   @default(now()) @map("scored_at")
  attempt         OdkExamAttempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scoredBy        User                       @relation("OdkAttemptScoreAdmin", fields: [scoredById], references: [id], onDelete: Restrict)
  questionResults OdkAttemptQuestionResult[]
  outcomeScores   OdkAttemptOutcomeScore[]

  @@index([scoredById, scoredAt])
  @@map("odk_attempt_scores")
}

model OdkAttemptQuestionResult {
  attemptId      String            @map("attempt_id")
  questionId     String            @map("question_id")
  selectedOption OdkAnswerOption?  @map("selected_option")
  correctOption  OdkAnswerOption   @map("correct_option")
  result         OdkQuestionResult
  score          OdkAttemptScore   @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)
  question       OdkExamQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@index([questionId, result])
  @@map("odk_attempt_question_results")
}

model OdkAttemptOutcomeScore {
  attemptId     String          @map("attempt_id")
  outcomeId     String          @map("outcome_id")
  questionCount Int             @map("question_count")
  correctCount  Int             @map("correct_count")
  wrongCount    Int             @map("wrong_count")
  blankCount    Int             @map("blank_count")
  accuracyRate  Decimal         @map("accuracy_rate") @db.Decimal(5, 2)
  score         OdkAttemptScore @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)
  outcome       LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@id([attemptId, outcomeId])
  @@index([outcomeId, accuracyRate])
  @@map("odk_attempt_outcome_scores")
}

model OdkOrder {
  id            String         @id @default(cuid())
  packageId     String         @map("package_id")
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  package       OdkPackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments      OdkPayment[]

  @@index([status, createdAt])
  @@map("odk_orders")
}

model OdkPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(MANUAL)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdkOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("odk_payments")
}

model OdOrder {
  id            String         @id @default(cuid())
  packageId     String?        @map("package_id")
  packageName   String         @map("package_name")
  category      String?
  subject       String?
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  intentId      String?        @map("intent_id")
  userId        String?        @map("user_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments      OdPayment[]
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([intentId])
  @@index([userId, createdAt])
  @@map("od_orders")
}

model OdPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(PAYTR)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("od_payments")
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             CouponType         @default(PERCENT)
  service          CouponService      @default(ALL)
  value            Int
  minOrderCents    Int                @default(0) @map("min_order_cents")
  maxDiscountCents Int                @default(0) @map("max_discount_cents")
  usageLimit       Int                @default(0) @map("usage_limit")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  startsAt         DateTime?          @map("starts_at")
  expiresAt        DateTime?          @map("expires_at")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  redemptions      CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String   @map("coupon_id")
  customerKey   String   @map("customer_key")
  orderService  String   @map("order_service")
  orderId       String   @map("order_id")
  discountCents Int      @map("discount_cents")
  redeemedAt    DateTime @default(now()) @map("redeemed_at")
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerKey])
  @@index([orderService, orderId])
  @@map("coupon_redemptions")
}
