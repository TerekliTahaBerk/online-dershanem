generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STUDENT
  TEACHER
  PARENT
}

enum VerificationCodeType {
  REGISTER
  PASSWORD_RESET
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

enum IntakeStatus {
  NEW
  REVIEWING
  CONTACTED
  ENROLLED
  ARCHIVED
}

enum PurchaseEventType {
  FORM_SUBMITTED
  PAYMENT_LINK_OPENED
  CALLBACK_RECEIVED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
}

enum StudentStatus {
  NEW
  FOLLOW_UP
  ACTIVE
  AT_RISK
  COMPLETED
  INACTIVE
}

model VerificationCode {
  id        String               @id @default(cuid())
  email     String
  code      String
  type      VerificationCodeType
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int?                 @default(0)
  createdAt DateTime             @default(now())

  @@index([email, type])
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
  ABANDONED
}

/// Transactional email outbox — written before the Resend call so delivery
/// can be retried if the serverless function crashes or Resend is transiently
/// unavailable. SENT/ABANDONED entries are safe to purge after 7 days.
model EmailOutbox {
  id          String            @id @default(cuid())
  recipients  String // JSON-serialised string[]
  subject     String
  html        String
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  sentAt      DateTime?         @map("sent_at")
  nextRetryAt DateTime?         @map("next_retry_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@map("email_outbox")
}

/// Lightweight DB-backed rate limiter — each row is one "token" consumed.
/// Caller counts rows with a given key in the recent window to enforce limits.
/// Old rows can be purged periodically (e.g. cron or on-demand).
model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String // e.g. "login:user@example.com" or "login:ip:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  passwordHash            String?
  role                    UserRole                 @default(ADMIN)
  onboardingCompletedAt   DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  student                 Student?
  teacher                 Teacher?
  parent                  Parent?
  notifications           Notification[]
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  createdContent          CourseContent[]          @relation("CourseContentCreator")
  odkCreatedExams         OdkExam[]                @relation("OdkExamCreator")
  odkUserAccessTags       OdkUserAccessTag[]
  odkOrders               OdkOrder[]
  odkEntitlements         OdkEntitlement[]
  odkAttempts             OdkExamAttempt[]
  odOrders                OdOrder[]
  assignedStudentPackages StudentPackage[]         @relation("StudentPackageAssignedBy")
  studentTagAssignments   StudentTag[]             @relation("StudentTagAssignedBy")
  attendanceRecords       Attendance[]             @relation("AttendanceRecorder")
  inboxReceived           InboxMessage[]           @relation("InboxRecipient")
  inboxSent               InboxMessage[]           @relation("InboxCreator")
  studentNotesAuthored    StudentNote[]            @relation("StudentNoteAuthor")
  studentFilesUploaded    StudentFile[]            @relation("StudentFileUploader")
  accountingEntries       AccountingEntry[]        @relation("AccountingCreator")
  permissionOverrides     UserPermissionOverride[]
  refreshTokens           RefreshToken[]
  savedViews              SavedView[]
  dashboardLayouts        DashboardLayout[]
  // ── Mobile (Faz Mobile) ──
  mobileDevices           MobileDevice[]
  notificationPrefs       NotificationPreference[]
  appActivityLogs         AppActivityLog[]
}

model LeadSubmission {
  id           String       @id @default(cuid())
  fullName     String
  phone        String
  classLevel   String
  examType     String
  targetGoal   String
  currentNet   String
  parentPhone  String?
  kvkkConsent  Boolean
  source       String
  intakeStatus IntakeStatus @default(NEW)
  adminNotes   String?
  taskLabel    String?
  nextActionAt DateTime?
  studentId    String?
  submittedAt  DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([intakeStatus, submittedAt])
}

model PurchaseIntent {
  id               String          @id @default(cuid())
  source           String
  packageName      String
  paymentLink      String?
  studentFullName  String
  studentPhone     String
  studentEmail     String
  schoolName       String
  city             String
  district         String
  classLevel       String
  department       String?
  examType         String
  targetSchool     String?
  targetRanking    String
  currentLevel     String
  currentNet       String
  weakLessons      String
  strongLessons    String?
  needType         String
  studyStatus      String
  weeklyStudyHours String
  parentFullName   String?
  parentPhone      String?
  parentEmail      String?
  notes            String?
  kvkkConsent      Boolean
  paymentConsent   Boolean
  status           PurchaseStatus  @default(PENDING)
  intakeStatus     IntakeStatus    @default(NEW)
  adminNotes       String?
  taskLabel        String?
  nextActionAt     DateTime?
  studentId        String?
  submittedAt      DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           PurchaseEvent[]
  student          Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([intakeStatus, submittedAt])
}

model Student {
  id                 String                     @id @default(cuid())
  fullName           String
  phone              String
  phoneKey           String                     @unique
  email              String?
  city               String?
  district           String?
  schoolName         String?
  classLevel         String?
  department         String?
  examType           String?
  currentLevel       String?
  currentNet         String?
  targetGoal         String?
  targetSchool       String?
  targetRanking      String?
  strongLessons      String?
  weakLessons        String?
  needType           String?
  studyStatus        String?
  weeklyStudyHours   String?
  parentFullName     String?
  parentPhone        String?
  parentEmail        String?
  source             String?
  activePackage      String?
  status             StudentStatus              @default(NEW)
  notes              String?
  taskLabel          String?
  nextActionAt       DateTime?
  submittedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  userId             String?                    @unique
  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadSubmissions    LeadSubmission[]
  purchaseIntents    PurchaseIntent[]
  lessons            Lesson[]
  packageEnrollments StudentPackageEnrollment[]
  courseProgress     StudentCourseProgress[]
  contentProgress    StudentContentProgress[]
  goals              StudentGoal[]
  examResults        StudentExamResult[]
  metricSnapshots    StudentMetricSnapshot[]
  packages           StudentPackage[]
  parents            ParentStudent[]
  classrooms         ClassroomStudent[]
  tags               StudentTag[]
  attendances        Attendance[]
  studentNotes       StudentNote[]
  comments           TeacherComment[]
  files              StudentFile[]
  directAssignments  Assignment[]               @relation("DirectAssignment")
  submissions        AssignmentSubmission[]
  accountingEntries  AccountingEntry[]          @relation("AccountingStudent")
  // ── Mobile (Faz Mobile) ──
  dailyTasks         StudentDailyTask[]

  @@index([status, updatedAt])
}

model PurchaseEvent {
  id                String            @id @default(cuid())
  purchaseIntentId  String
  eventType         PurchaseEventType
  status            PurchaseStatus
  source            String
  packageName       String
  paymentLink       String?
  provider          String?
  providerReference String?
  payload           Json?
  createdAt         DateTime          @default(now())
  purchaseIntent    PurchaseIntent    @relation(fields: [purchaseIntentId], references: [id], onDelete: Cascade)

  @@index([purchaseIntentId, createdAt])
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CampCategory {
  AYT
  TYT
  LGS
}

enum EnrollmentStatus {
  LEAD
  TRIAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EnrollmentSource {
  MANUAL
  PURCHASE
  TRIAL
  CAMP
  SCHOLARSHIP
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  LIVE_SESSION
  VIDEO
  NOTE
  PDF
  QUIZ
  ASSIGNMENT
  LINK
}

enum StudentContentProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum StudentGoalStatus {
  ACTIVE
  COMPLETED
  MISSED
  ARCHIVED
}

enum AssessmentType {
  DENEME
  QUIZ
  HOMEWORK
  MOCK_INTERVIEW
}

enum NotificationType {
  SYSTEM
  LESSON
  CONTENT
  PAYMENT
  PERFORMANCE
  ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MetricPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum AuditActorType {
  SYSTEM
  USER
}

enum PackageType {
  COURSE
  EXAM
}

model Teacher {
  id                String             @id @default(cuid())
  fullName          String
  email             String?            @unique
  phone             String?
  subjects          String
  bio               String?
  status            TeacherStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            String?            @unique
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  lessons           Lesson[]
  classrooms        ClassroomTeacher[]
  comments          TeacherComment[]
  assignments       Assignment[]
  payrolls          TeacherPayroll[]
  accountingEntries AccountingEntry[]  @relation("AccountingTeacher")
  defaultForCourses Course[]           @relation("CourseDefaultTeacher")

  @@index([status])
}

model Package {
  id                String                     @id @default(cuid())
  name              String
  type              PackageType                @default(COURSE)
  description       String?
  price             Int
  paytrLink         String?
  lessonCount       Int
  subjects          String
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  lessons           Lesson[]
  enrollments       StudentPackageEnrollment[]
  packageCourses    PackageCourse[]
  studentPackages   StudentPackage[]
  accountingEntries AccountingEntry[]          @relation("AccountingPackage")
  odOrders          OdOrder[]

  @@index([isActive])
  @@index([type, isActive])
}

model StudentPackage {
  studentId    String
  packageId    String
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  assignedById String?
  notes        String?
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package      Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("StudentPackageAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([studentId, packageId])
  @@index([packageId])
  @@index([studentId, revokedAt, expiresAt])
}

model Camp {
  id            String       @id @default(cuid())
  name          String
  detail        String
  category      CampCategory
  quota         Int          @default(8)
  price         Int          @default(200000)
  originalPrice Int          @default(500000)
  paytrLink     String?
  isActive      Boolean      @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category, isActive])
}

model Lesson {
  id             String       @id @default(cuid())
  studentId      String
  teacherId      String
  packageId      String?
  classroomId    String?
  courseId       String?
  seriesId       String?
  sessionGroupId String?
  location       String?
  title          String?
  subject        String?
  scheduledAt    DateTime
  duration       Int          @default(60)
  googleMeetLink String?
  status         LessonStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  package        Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  classroom      Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  attendances    Attendance[]

  @@index([studentId, scheduledAt])
  @@index([teacherId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([classroomId, scheduledAt])
  @@index([courseId, scheduledAt])
  @@index([seriesId])
  @@index([sessionGroupId])
}

model StudentPackageEnrollment {
  id                 String                  @id @default(cuid())
  studentId          String
  packageId          String
  source             EnrollmentSource        @default(MANUAL)
  status             EnrollmentStatus        @default(ACTIVE)
  startsAt           DateTime                @default(now())
  endsAt             DateTime?
  autoRenew          Boolean                 @default(false)
  listPrice          Int?
  discountAmount     Int?
  billingPeriodLabel String?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package            Package                 @relation(fields: [packageId], references: [id], onDelete: Restrict)
  courseProgress     StudentCourseProgress[]

  @@index([studentId, status])
  @@index([packageId, status])
  @@index([startsAt, endsAt])
}

model Course {
  id                 String                  @id @default(cuid())
  title              String
  slug               String                  @unique
  description        String?
  subject            String
  examType           String?
  levelLabel         String?
  estimatedMinutes   Int?
  status             CourseStatus            @default(DRAFT)
  isActive           Boolean                 @default(true)
  coverImageUrl      String?
  defaultTeacherId   String?
  defaultClassroomId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  modules            CourseModule[]
  packageCourses     PackageCourse[]
  studentProgress    StudentCourseProgress[]
  lessons            Lesson[]
  defaultTeacher     Teacher?                @relation("CourseDefaultTeacher", fields: [defaultTeacherId], references: [id], onDelete: SetNull)
  defaultClassroom   Classroom?              @relation("CourseDefaultClassroom", fields: [defaultClassroomId], references: [id], onDelete: SetNull)

  @@index([status, subject])
  @@index([defaultTeacherId])
  @@index([defaultClassroomId])
  @@index([isActive])
}

model CourseModule {
  id          String          @id @default(cuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contents    CourseContent[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
}

model CourseContent {
  id              String                   @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  contentType     ContentType
  orderIndex      Int                      @default(0)
  durationMinutes Int?
  status          CourseStatus             @default(DRAFT)
  liveStartsAt    DateTime?
  liveEndsAt      DateTime?
  videoUrl        String?
  fileUrl         String?
  externalUrl     String?
  createdById     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  module          CourseModule             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy       User?                    @relation("CourseContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  progress        StudentContentProgress[]

  @@unique([moduleId, orderIndex])
  @@index([moduleId, status])
}

model PackageCourse {
  packageId  String
  courseId   String
  isRequired Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([packageId, courseId])
  @@index([courseId])
}

model StudentCourseProgress {
  id                String                    @id @default(cuid())
  studentId         String
  courseId          String
  enrollmentId      String?
  completionPercent Int                       @default(0)
  completedContent  Int                       @default(0)
  totalContent      Int                       @default(0)
  lastOpenedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  student           Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course            Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment        StudentPackageEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@index([enrollmentId])
  @@index([studentId, completionPercent])
}

model StudentContentProgress {
  id                String                       @id @default(cuid())
  studentId         String
  contentId         String
  status            StudentContentProgressStatus @default(NOT_STARTED)
  completionPercent Int                          @default(0)
  secondsSpent      Int                          @default(0)
  lastOpenedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  student           Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content           CourseContent                @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId, status])
  @@index([contentId])
}

model StudentGoal {
  id           String            @id @default(cuid())
  studentId    String
  title        String
  description  String?
  unit         String?
  targetValue  Decimal?          @db.Decimal(8, 2)
  currentValue Decimal?          @db.Decimal(8, 2)
  dueAt        DateTime?
  status       StudentGoalStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([dueAt])
}

model StudentExamResult {
  id             String                   @id @default(cuid())
  studentId      String
  assessmentType AssessmentType           @default(DENEME)
  examType       String?
  title          String
  takenAt        DateTime
  score          Decimal?                 @db.Decimal(6, 2)
  net            Decimal?                 @db.Decimal(6, 2)
  correctCount   Int                      @default(0)
  wrongCount     Int                      @default(0)
  blankCount     Int                      @default(0)
  ranking        Int?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectStats   StudentExamSubjectStat[]

  @@index([studentId, takenAt])
  @@index([assessmentType, examType])
}

model StudentExamSubjectStat {
  id           String                 @id @default(cuid())
  examResultId String
  subject      String
  correctCount Int                    @default(0)
  wrongCount   Int                    @default(0)
  blankCount   Int                    @default(0)
  net          Decimal?               @db.Decimal(6, 2)
  maxNet       Decimal?               @db.Decimal(6, 2)
  trendDelta   Decimal?               @db.Decimal(6, 2)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  examResult   StudentExamResult      @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  topicStats   StudentExamTopicStat[]

  @@unique([examResultId, subject])
  @@index([subject])
}

model StudentExamTopicStat {
  id            String                 @id @default(cuid())
  subjectStatId String
  topic         String
  correctCount  Int                    @default(0)
  wrongCount    Int                    @default(0)
  blankCount    Int                    @default(0)
  net           Decimal?               @db.Decimal(6, 2)
  masteryPct    Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  subjectStat   StudentExamSubjectStat @relation(fields: [subjectStatId], references: [id], onDelete: Cascade)

  @@unique([subjectStatId, topic])
  @@index([topic])
}

model StudentMetricSnapshot {
  id        String       @id @default(cuid())
  studentId String
  metricKey String
  value     Decimal      @db.Decimal(8, 2)
  unit      String?
  period    MetricPeriod
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime     @default(now())
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, metricKey, period])
  @@index([startsAt, endsAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType     @default(SYSTEM)
  priority  NotificationPriority @default(NORMAL)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, priority])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorUserId String?
  actorType   AuditActorType @default(USER)
  entityType  String
  entityId    String
  action      String
  summary     String?
  payload     Json?
  createdAt   DateTime       @default(now())
  actor       User?          @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

// ─── ODK Enums ────────────────────────────────────────────────────────────────

enum OdkExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OdkExamCadenceFamily {
  TYT
  AYT
  LGS
  KPSS
  ALES
}

enum OdkExamFileType {
  BOOKLET_PDF
  ANSWER_KEY_PDF
}

enum OdkAccessTagGrantSource {
  PURCHASE
  MANUAL
}

enum AccessService {
  OD
  ODK
}

enum OdkOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum OdkPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OdkPaymentProvider {
  MANUAL
  IYZICO
  BANK_TRANSFER
  PAYTR
}

enum OdkEntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OdkAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

// ─── ODK Models ───────────────────────────────────────────────────────────────

model OdkExamSeries {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  cadenceFamily OdkExamCadenceFamily @map("cadence_family")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  exams         OdkExam[]

  @@index([cadenceFamily, isActive])
  @@map("odk_exam_series")
}

model OdkExam {
  id                  String               @id @default(cuid())
  title               String
  slug                String               @unique
  description         String?
  cadenceFamily       OdkExamCadenceFamily @map("cadence_family")
  classLevel          String?              @map("class_level")
  examSeriesId        String?              @map("exam_series_id")
  status              OdkExamStatus        @default(DRAFT)
  durationMinutes     Int                  @default(120) @map("duration_minutes")
  startsAt            DateTime?            @map("starts_at")
  endsAt              DateTime?            @map("ends_at")
  publishedAt         DateTime?            @map("published_at")
  answerKeyReleasedAt DateTime?            @map("answer_key_released_at")
  resultsReleasedAt   DateTime?            @map("results_released_at")
  googleMeetLink      String?              @map("google_meet_link")
  /// JSON: { showResultImmediately, showAnswerKeyImmediately, allowReview,
  /// fullscreenRequired, blockCopyPaste, autoSubmitOnFullscreenExit, warnOnViolation }
  settings            Json?
  createdById         String?              @map("created_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  examSeries          OdkExamSeries?       @relation(fields: [examSeriesId], references: [id], onDelete: SetNull)
  creator             User?                @relation("OdkExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sections            OdkExamSection[]
  files               OdkExamFile[]
  attempts            OdkExamAttempt[]
  examAccessTags      OdkExamAccessTag[]
  packageExams        OdkPackageExam[]

  @@index([status])
  @@index([cadenceFamily, status])
  @@map("odk_exams")
}

model OdkExamSection {
  id              String                    @id @default(cuid())
  examId          String                    @map("exam_id")
  title           String
  questionCount   Int                       @map("question_count")
  orderIndex      Int                       @default(0) @map("order_index")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  exam            OdkExam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  officialAnswers OdkExamOfficialAnswer[]
  opticalAnswers  OdkAttemptOpticalAnswer[]

  @@unique([examId, orderIndex])
  @@index([examId])
  @@map("odk_exam_sections")
}

model OdkExamOfficialAnswer {
  id                  String         @id @default(cuid())
  examId              String         @map("exam_id")
  sectionId           String         @map("section_id")
  questionNumber      Int            @map("question_number")
  correctOption       String         @map("correct_option")
  /// Faz-1 legacy: { konu, kazanim, altKazanim? }. Faz-2 zenginleştirilmiş şema:
  /// { lesson, unit?, topic?, learningOutcomeCode?, learningOutcome?, difficulty? }
  outcomes            Json?
  // Faz-2: Zenginleştirilmiş kazanım alanları (nullable; outcomes JSON ile birlikte yazılır).
  lesson              String?        @map("lesson")
  unit                String?        @map("unit")
  topic               String?        @map("topic")
  learningOutcomeCode String?        @map("learning_outcome_code")
  learningOutcome     String?        @map("learning_outcome")
  difficulty          String?        @map("difficulty")
  createdAt           DateTime       @default(now()) @map("created_at")
  section             OdkExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, questionNumber])
  @@index([examId])
  @@index([examId, learningOutcomeCode])
  @@map("odk_exam_official_answers")
}

model OdkExamFile {
  id               String          @id @default(cuid())
  examId           String          @map("exam_id")
  fileType         OdkExamFileType @map("file_type")
  originalFileName String          @map("original_file_name")
  publicUrl        String          @map("public_url")
  byteSize         Int             @default(0) @map("byte_size")
  uploadedById     String?         @map("uploaded_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  exam             OdkExam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, fileType])
  @@index([examId])
  @@map("odk_exam_files")
}

model OdkAccessTag {
  id          String                @id @default(cuid())
  key         String                @unique
  title       String
  description String?
  service     AccessService         @default(ODK)
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  userTags    OdkUserAccessTag[]
  examTags    OdkExamAccessTag[]
  packageTags OdkPackageAccessTag[]

  @@index([isActive])
  @@index([service, isActive])
  @@map("odk_access_tags")
}

model OdkUserAccessTag {
  id            String                  @id @default(cuid())
  userId        String                  @map("user_id")
  accessTagId   String                  @map("access_tag_id")
  source        OdkAccessTagGrantSource @default(MANUAL)
  grantedById   String?                 @map("granted_by_id")
  entitlementId String?                 @map("entitlement_id")
  expiresAt     DateTime?               @map("expires_at")
  revokedAt     DateTime?               @map("revoked_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTag     OdkAccessTag            @relation(fields: [accessTagId], references: [id], onDelete: Cascade)
  entitlement   OdkEntitlement?         @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@unique([userId, accessTagId])
  @@index([userId, revokedAt, expiresAt])
  @@index([accessTagId])
  @@map("odk_user_access_tags")
}

model OdkExamAccessTag {
  examId      String       @map("exam_id")
  accessTagId String       @map("access_tag_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  exam        OdkExam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  accessTag   OdkAccessTag @relation(fields: [accessTagId], references: [id], onDelete: Cascade)

  @@id([examId, accessTagId])
  @@index([accessTagId])
  @@map("odk_exam_access_tags")
}

model OdkPackage {
  id                String                @id @default(cuid())
  title             String
  slug              String                @unique
  description       String?
  priceCents        Int                   @map("price_cents")
  originalPriceCents Int?                 @map("original_price_cents")
  durationDays      Int?                  @map("duration_days")
  isActive          Boolean               @default(true) @map("is_active")
  isFeatured        Boolean               @default(false) @map("is_featured")
  ctaText           String?               @map("cta_text")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  packageExams      OdkPackageExam[]
  packageAccessTags OdkPackageAccessTag[]
  orders            OdkOrder[]
  entitlements      OdkEntitlement[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("odk_packages")
}

model OdkPackageExam {
  packageId String     @map("package_id")
  examId    String     @map("exam_id")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  package   OdkPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  exam      OdkExam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([packageId, examId])
  @@index([examId])
  @@map("odk_package_exams")
}

model OdkPackageAccessTag {
  packageId   String       @map("package_id")
  accessTagId String       @map("access_tag_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  package     OdkPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  accessTag   OdkAccessTag @relation(fields: [accessTagId], references: [id], onDelete: Cascade)

  @@id([packageId, accessTagId])
  @@index([accessTagId])
  @@map("odk_package_access_tags")
}

model OdkOrder {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  packageId     String           @map("package_id")
  status        OdkOrderStatus   @default(PENDING)
  subtotalCents Int              @map("subtotal_cents")
  discountCents Int              @default(0) @map("discount_cents")
  totalCents    Int              @map("total_cents")
  buyerInfo     Json?            @map("buyer_info")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  package       OdkPackage       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payments      OdkPayment[]
  entitlements  OdkEntitlement[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("odk_orders")
}

model OdkPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(MANUAL)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdkOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("odk_payments")
}

model OdkEntitlement {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  packageId      String               @map("package_id")
  orderId        String?              @unique @map("order_id")
  status         OdkEntitlementStatus @default(ACTIVE)
  startsAt       DateTime             @default(now()) @map("starts_at")
  expiresAt      DateTime?            @map("expires_at")
  revokedAt      DateTime?            @map("revoked_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  package        OdkPackage           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  order          OdkOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userAccessTags OdkUserAccessTag[]
  attempts       OdkExamAttempt[]

  @@index([userId, status])
  @@map("odk_entitlements")
}

model OdkExamAttempt {
  id                  String                    @id @default(cuid())
  userId              String                    @map("user_id")
  examId              String                    @map("exam_id")
  entitlementId       String?                   @map("entitlement_id")
  status              OdkAttemptStatus          @default(IN_PROGRESS)
  startedAt           DateTime                  @default(now()) @map("started_at")
  submittedAt         DateTime?                 @map("submitted_at")
  score               Decimal?                  @db.Decimal(6, 2)
  correctCount        Int                       @default(0) @map("correct_count")
  wrongCount          Int                       @default(0) @map("wrong_count")
  blankCount          Int                       @default(0) @map("blank_count")
  resultPayload       Json?                     @map("result_payload")
  sectionScores       Json?                     @map("section_scores")
  tabSwitchCount      Int                       @default(0) @map("tab_switch_count")
  cheatViolationCount Int                       @default(0) @map("cheat_violation_count")
  lastEventAt         DateTime?                 @map("last_event_at")
  autoSubmitted       Boolean                   @default(false) @map("auto_submitted")
  durationSeconds     Int?                      @map("duration_seconds")
  /// Denormalized 0-1 suspicion score derived from integrityFlags at submit time.
  /// 0 = no signals, 1 = maximally suspicious. Null for auto-submitted attempts
  /// with no answer-timing data. Use for ORDER BY / filter without JSON parsing.
  suspiciousScore     Float?                    @map("suspicious_score")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam                OdkExam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  entitlement         OdkEntitlement?           @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  opticalAnswers      OdkAttemptOpticalAnswer[]
  events              OdkExamAttemptEvent[]

  @@index([userId, examId])
  @@index([userId, status])
  // Compound indexes for admin stats queries (examId + status + time)
  @@index([examId, status, submittedAt])
  @@index([examId, status, startedAt])
  @@map("odk_exam_attempts")
}

enum OdkAttemptEventType {
  TAB_BLUR
  TAB_FOCUS
  VISIBILITY_HIDDEN
  VISIBILITY_VISIBLE
  FULLSCREEN_ENTER
  FULLSCREEN_EXIT
  RIGHT_CLICK
  COPY
  PASTE
  CUT
  PRINT
  KEY_DEVTOOLS
  ANSWER_CHANGE
  NAVIGATE
  AUTOSAVE
  NETWORK_DROP
  NETWORK_RESUME
  WARNING_SHOWN
}

/// Cheat / UX olayı (sekme geçişi, fokus kaybı, kopyala-yapıştır vb.).
/// Submit sonrası audit ve istatistik için saklanır.
model OdkExamAttemptEvent {
  id             String              @id @default(cuid())
  attemptId      String              @map("attempt_id")
  type           OdkAttemptEventType
  questionNumber Int?                @map("question_number")
  payload        Json?
  occurredAt     DateTime            @default(now()) @map("occurred_at")
  attempt        OdkExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@index([attemptId, type])
  @@map("odk_exam_attempt_events")
}

model OdkAttemptOpticalAnswer {
  id             String         @id @default(cuid())
  attemptId      String         @map("attempt_id")
  sectionId      String         @map("section_id")
  questionNumber Int            @map("question_number")
  selectedOption String         @map("selected_option")
  answeredAt     DateTime       @default(now()) @map("answered_at")
  attempt        OdkExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section        OdkExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId, questionNumber])
  @@index([attemptId])
  @@map("odk_attempt_optical_answers")
}

// ─── Panel Foundation (Faz 0) ────────────────────────────────────────────────
// Veli (Parent), Sınıf (Classroom), Tag ve Yoklama (Attendance) modelleri.
// Detaylar: docs/panel-system-master-plan.md

enum ClassroomLevel {
  LGS
  TYT
  AYT
  YDT
  MIXED
}

enum TagColor {
  GRAY
  BLUE
  GREEN
  YELLOW
  ORANGE
  RED
  PURPLE
  PINK
}

enum TagScope {
  STUDENT
  TEACHER
  PARENT
  GENERAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceContext {
  LESSON
  CLASSROOM_SESSION
}

/// Veli kaydı. Opsiyonel olarak `User` (role=PARENT) ile bağlanır; bağlanırsa
/// veli paneline (`/veli`) erişebilir. Bir veli birden fazla öğrenciye
/// (kardeşler) bağlanabilir — `ParentStudent` join modeline bakın.
model Parent {
  id        String          @id @default(cuid())
  fullName  String
  phone     String?
  /// Telefon numarasının normalize edilmiş hâli (Student.phoneKey ile aynı mantık).
  phoneKey  String?         @unique
  email     String?         @unique
  notes     String?
  userId    String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  students  ParentStudent[]
}

model ParentStudent {
  parentId     String
  studentId    String
  /// "Anne", "Baba", "Vasi", "Diğer" — serbest metin.
  relationship String?
  /// Birden fazla veli bağlıyken birincil iletişim kim?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

/// Sınıf/şube. İleride grup dersleri (`Lesson.classroomId`) ve sınıf bazlı
/// yoklama (`Attendance.classroomId`) için temel.
model Classroom {
  id          String             @id @default(cuid())
  name        String
  branch      String?
  level       ClassroomLevel     @default(MIXED)
  capacity    Int                @default(30)
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  teachers    ClassroomTeacher[]
  students    ClassroomStudent[]
  attendances Attendance[]
  lessons     Lesson[]
  assignments Assignment[]
  defaultForCourses Course[]         @relation("CourseDefaultClassroom")

  @@unique([name, branch])
  @@index([isActive])
}

model ClassroomTeacher {
  classroomId String
  teacherId   String
  isLead      Boolean   @default(false)
  subject     String?
  createdAt   DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classroomId, teacherId])
  @@index([teacherId])
}

model ClassroomStudent {
  classroomId String
  studentId   String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@index([studentId])
  @@index([classroomId, leftAt])
}

/// Genel etiket (tag) modeli. Şu an `StudentTag` üzerinden öğrencilere atanır;
/// `scope` enum'u ile ileride öğretmen/veli için de kullanılabilir.
model Tag {
  id          String       @id @default(cuid())
  /// URL-safe benzersiz anahtar (örn. "vip", "riskli").
  key         String       @unique
  label       String
  color       TagColor     @default(GRAY)
  scope       TagScope     @default(STUDENT)
  description String?
  /// Sistem tarafından otomatik oluşturulmuş tag ise admin silemez.
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  students    StudentTag[]

  @@index([scope])
}

model StudentTag {
  studentId    String
  tagId        String
  assignedById String?
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?
  note         String?
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tag          Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("StudentTagAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([studentId, tagId])
  @@index([tagId])
  @@index([assignedById])
}

/// Yoklama kaydı. `context=LESSON` ise `lessonId` doludur (her öğrenci-ders
/// için tek kayıt — partial unique index migration'da tanımlı). `context=
/// CLASSROOM_SESSION` ise `classroomId` doludur ve aynı gün için birden fazla
/// satır olabilir.
model Attendance {
  id           String            @id @default(cuid())
  studentId    String
  context      AttendanceContext @default(LESSON)
  lessonId     String?
  classroomId  String?
  sessionDate  DateTime
  status       AttendanceStatus
  minutesLate  Int?
  notes        String?
  recordedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  classroom    Classroom?        @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  recordedBy   User?             @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, sessionDate])
  @@index([classroomId, sessionDate])
  @@index([status])
}

// ─── Inbox System (Faz 1) ────────────────────────────────────────────────────
// Birleşik bildirim/inbox omurgası. Mevcut `Notification` modeli read-only
// olarak kalır (legacy); yeni event'ler bu modele yazılır.
//
// `relatedEntityType` + `relatedEntityId` polymorphic referans tutar; örn.
// "Lesson" + "<lessonId>" → tıklandığında `/panel/dersler/<id>` linkine atar.

enum InboxCategory {
  SYSTEM
  FINANCE
  EDUCATION
  ANNOUNCEMENT
  TEACHER_MESSAGE
  ATTENDANCE
  ASSIGNMENT
}

enum InboxPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model InboxMessage {
  id                String        @id @default(cuid())
  recipientUserId   String
  category          InboxCategory @default(SYSTEM)
  priority          InboxPriority @default(NORMAL)
  title             String
  body              String
  href              String?
  relatedEntityType String?
  relatedEntityId   String?
  createdById       String?
  readAt            DateTime?
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  recipient         User          @relation("InboxRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdBy         User?         @relation("InboxCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientUserId, archivedAt])
  @@index([category, priority])
}

// ─── CRM Notes / Comments / Files (Faz 3) ───────────────────────────────────

/// Admin/öğretmen tarafından öğrenci kayıtlarına eklenen iç notlar.
/// `isPrivate=true` → sadece admin görür; veli/öğretmen görmez.
model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  authorId  String?
  content   String
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author    User?    @relation("StudentNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
}

/// Öğretmenin öğrenci için yazdığı veliyle paylaşılabilen yorum/değerlendirme.
model TeacherComment {
  id              String   @id @default(cuid())
  studentId       String
  teacherId       String
  content         String
  rating          Int?
  visibleToParent Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
}

/// Öğrenci dosyaları (transkript, ödev, kimlik vb.). Vercel Blob URL'i tutar.
model StudentFile {
  id           String   @id @default(cuid())
  studentId    String
  uploadedById String?
  fileName     String
  fileUrl      String
  byteSize     Int      @default(0)
  mimeType     String?
  description  String?
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("StudentFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
}

// ─── Assignment / Submission (Faz 4) ────────────────────────────────────────

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
  MISSED
}

/// Ödev. Üç şekilde dağıtılabilir:
///   1) classroomId dolu → o sınıftaki tüm öğrenciler
///   2) studentId dolu (DirectAssignment) → tek öğrenciye
///   3) ikisi de null → öğretmenin tüm aktif öğrencilerine (geniş)
model Assignment {
  id            String                 @id @default(cuid())
  teacherId     String
  classroomId   String?
  studentId     String?
  title         String
  description   String?
  subject       String?
  dueAt         DateTime?
  maxScore      Int?
  attachmentUrl String?
  status        AssignmentStatus       @default(PUBLISHED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  teacher       Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom     Classroom?             @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  student       Student?               @relation("DirectAssignment", fields: [studentId], references: [id], onDelete: SetNull)
  submissions   AssignmentSubmission[]

  @@index([teacherId, status])
  @@index([classroomId, status])
  @@index([dueAt])
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  status        SubmissionStatus @default(PENDING)
  content       String?
  attachmentUrl String?
  submittedAt   DateTime?
  score         Int?
  feedback      String?
  gradedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

// ─── Accounting (Faz 5) ─────────────────────────────────────────────────────

enum EntryType {
  INCOME
  EXPENSE
}

enum EntryCategory {
  PACKAGE_SALE
  CAMP_SALE
  SERVICE_FEE
  OTHER_INCOME
  TEACHER_PAYROLL
  MARKETING
  RENT
  TAX
  OPERATIONAL
  OTHER_EXPENSE
}

enum PayrollStatus {
  DUE
  PAID
  CANCELLED
}

/// Tek satırlık muhasebe kaydı (gelir veya gider). Tutar `Int` (kuruş).
/// `refType`/`refId` polymorphic kaynak referansı (örn. PurchaseIntent, TeacherPayroll).
/// `service` = OD veya ODK — ürün bazlı muhasebe ayrımı (FAZ 4).
model AccountingEntry {
  id          String        @id @default(cuid())
  service     AccessService @default(OD)
  type        EntryType
  category    EntryCategory @default(OTHER_INCOME)
  amount      Int
  occurredAt  DateTime      @default(now())
  description String?
  refType     String?
  refId       String?
  studentId   String?
  packageId   String?
  teacherId   String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  student     Student?      @relation("AccountingStudent", fields: [studentId], references: [id], onDelete: SetNull)
  package     Package?      @relation("AccountingPackage", fields: [packageId], references: [id], onDelete: SetNull)
  teacher     Teacher?      @relation("AccountingTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("AccountingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([category, occurredAt])
  @@index([studentId])
  @@index([teacherId])
  @@index([service, occurredAt])
  @@index([service, type])
}

/// Öğretmen maaş döngüsü (örn. Mart 2026 maaşı). PAID olduğunda otomatik olarak
/// bir AccountingEntry (EXPENSE / TEACHER_PAYROLL) yazılır.
model TeacherPayroll {
  id          String        @id @default(cuid())
  teacherId   String
  periodStart DateTime
  periodEnd   DateTime
  amount      Int
  status      PayrollStatus @default(DUE)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  teacher     Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, periodStart, periodEnd])
  @@index([teacherId, status])
  @@index([status, periodEnd])
}

// ─── Permission System (Faz 0 — Rebuild) ────────────────────────────────────
// DB-driven RBAC. Defaults seeded from `lib/rbac/matrix.ts` via
// `prisma/seeds/permissions.ts`. Per-user overrides in `UserPermissionOverride`.

/// Permission key registry. Source of truth is `lib/rbac/matrix.ts` —
/// seed script upserts these. UI reads via `/api/v1/me/permissions`.
model Permission {
  id              String                   @id @default(cuid())
  /// "students.read", "payments.write", etc.
  key             String                   @unique
  category        String
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([category])
}

/// Default permission set per role.
model RolePermission {
  role         UserRole
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

/// Per-user override on top of role defaults.
/// granted=true → ekle, granted=false → çıkar.
model UserPermissionOverride {
  userId       String
  permissionId String
  granted      Boolean
  reason       String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

/// Refresh token — JWT rotation. Faz 0'da tablo eklendi, Faz 4'te kullanılacak.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Saved table filters / segments — admin "VIP öğrenciler", "Geç ödeyenler" gibi.
model SavedView {
  id        String   @id @default(cuid())
  ownerId   String
  /// "students" | "payments" | "lessons" | ...
  scope     String
  name      String
  filter    Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, scope])
  @@index([scope, isShared])
}

enum DashboardPanelKey {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

/// Per-user dashboard widget layout (react-grid-layout JSON).
model DashboardLayout {
  userId    String
  panel     DashboardPanelKey
  layout    Json
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, panel])
}

/// Realtime event log — Pusher pivot, audit-friendly.
/// channel format: "user:<id>" | "classroom:<id>" | "panel:<panel>" | "global"
model RealtimeEvent {
  id        String   @id @default(cuid())
  channel   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@index([type, createdAt])
}

// ─── Mobile (Faz Mobile) ─────────────────────────────────────────────────────
// Mobil uygulama için additive (mevcut hiçbir tablo değişmez).
// Detay: mobile-app/docs/BACKEND_GAPS.md

enum MobilePlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationChannel {
  PUSH
  INBOX
  EMAIL
}

enum NotificationCategoryKey {
  LESSON
  ASSIGNMENT
  EXAM
  ANNOUNCEMENT
  TEACHER_MESSAGE
  ATTENDANCE
  PAYMENT
  SYSTEM
}

/// Kullanıcının mobil cihazları — push token registry.
/// Bir kullanıcının birden çok cihazı olabilir (telefon + tablet).
model MobileDevice {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  expoPushToken String         @unique @map("expo_push_token")
  platform      MobilePlatform
  appVersion    String         @map("app_version")
  deviceModel   String?        @map("device_model")
  osVersion     String?        @map("os_version")
  locale        String?
  timezone      String?
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
  @@map("mobile_devices")
}

/// Kullanıcı bazında bildirim tercihleri (kategori × kanal).
/// Eksik satır = açık (defansif default).
model NotificationPreference {
  id        String                  @id @default(cuid())
  userId    String                  @map("user_id")
  category  NotificationCategoryKey
  channel   NotificationChannel
  enabled   Boolean                 @default(true)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@index([userId])
  @@map("notification_preferences")
}

enum DailyTaskSource {
  ASSIGNMENT
  LESSON
  EXAM
  GOAL
  MANUAL
}

/// Mobil-spesifik öğrenci todo. Streak hesabı buradan beslenir.
model StudentDailyTask {
  id          String          @id @default(cuid())
  studentId   String          @map("student_id")
  title       String
  description String?
  sourceType  DailyTaskSource @map("source_type")
  sourceId    String?         @map("source_id")
  dueAt       DateTime?       @map("due_at")
  isDone      Boolean         @default(false) @map("is_done")
  doneAt      DateTime?       @map("done_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dueAt])
  @@index([studentId, isDone])
  @@map("student_daily_tasks")
}

/// Mobil ekran görüntüleme / app açılış telemetrisi (streak için).
model AppActivityLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("app_activity_logs")
}

// ──────────────────────────────────────────────────────────────────────────
// Online Dershanem (OD) ödeme akışı — paket bazlı (Package) tek seferlik
// ödeme. ODK ile aynı PayTR altyapısını kullanır; merchant_oid prefix'i
// "OD" ile başlar. Başarılı ödeme sonrası entitlement OTOMATİK YOK; admin
// hocaları manuel atayacaktır. PurchaseIntent kaydı linklenir.
// ──────────────────────────────────────────────────────────────────────────

model OdOrder {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  packageId    String?         @map("package_id")
  packageName   String         @map("package_name")
  category      String?
  subject       String?
  status        OdkOrderStatus @default(PENDING)
  subtotalCents Int            @map("subtotal_cents")
  discountCents Int            @default(0) @map("discount_cents")
  totalCents    Int            @map("total_cents")
  buyerInfo     Json?          @map("buyer_info")
  intentId      String?        @map("intent_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments      OdPayment[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([intentId])
  @@map("od_orders")
}

model OdPayment {
  id            String             @id @default(cuid())
  orderId       String             @map("order_id")
  provider      OdkPaymentProvider @default(PAYTR)
  providerRef   String?            @map("provider_ref")
  status        OdkPaymentStatus   @default(PENDING)
  amountCents   Int                @map("amount_cents")
  paidAt        DateTime?          @map("paid_at")
  failureReason String?            @map("failure_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  order         OdOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("od_payments")
}
