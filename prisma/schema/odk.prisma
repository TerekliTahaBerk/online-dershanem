}

/// Aynı sınav ailesinde tekrar eden matematik denemelerini gruplar.
model OdkExamSeries {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  family          OdkExamFamily?
  examFamilyRefId String?       @map("exam_family_ref_id")
  academicYear    Int           @map("academic_year")
  classLevel      String?       @map("class_level")
  isActive        Boolean       @default(true) @map("is_active")
  createdById     String        @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       User          @relation("OdkExamSeriesCreator", fields: [createdById], references: [id], onDelete: Restrict)
  examFamilyRef   ExamFamily?   @relation(fields: [examFamilyRefId], references: [id], onDelete: Restrict)
  exams           OdkExam[]

  @@index([family, academicYear, isActive])
  @@index([examFamilyRefId, academicYear, isActive])
  @@index([createdById, createdAt])
  @@index([examFamilyRefId])
  @@map("odk_exam_series")
}

/// Takvim ve yayın yaşam döngüsü. Soru içeriği sürümlerde dondurulur.
/// Durum eşlemesi (ürün dili → DB): CLOSED→ENDED, REVIEW→SCORED, PUBLISHED→RELEASED.
model OdkExam {
  id                  String               @id @default(cuid())
  seriesId            String?              @map("series_id")
  title               String
  slug                String               @unique
  family              OdkExamFamily?
  examFamilyRefId     String?              @map("exam_family_ref_id")
  status              OdkExamStatus        @default(DRAFT)
  structureMode       OdkExamStructureMode @default(MATH_ONLY) @map("structure_mode")
  templateCode        String?              @map("template_code")
  description         String?
  internalCode        String?              @map("internal_code")
  academicYear        Int?                 @map("academic_year")
  publisher           String?
  settings            Json                 @default("{}")
  currentVersionId    String?              @unique @map("current_version_id")
  startsAt            DateTime?            @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime?            @map("ends_at") @db.Timestamptz(3)
  lateEntryMinutes    Int                  @default(0) @map("late_entry_minutes")
  attemptLimit        Int                  @default(1) @map("attempt_limit")
  meetRequired        Boolean              @default(true) @map("meet_required")
  meetUrl             String?              @map("meet_url")
  answerKeyReleasedAt DateTime?            @map("answer_key_released_at") @db.Timestamptz(3)
  resultsReleasedAt   DateTime?            @map("results_released_at") @db.Timestamptz(3)
  publishedAt         DateTime?            @map("published_at") @db.Timestamptz(3)
  contentLockedAt     DateTime?            @map("content_locked_at") @db.Timestamptz(3)
  createdById         String               @map("created_by_id")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  series              OdkExamSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("OdkExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  examFamilyRef       ExamFamily?          @relation(fields: [examFamilyRefId], references: [id], onDelete: Restrict)
  currentVersion      OdkExamVersion?      @relation("OdkCurrentExamVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions            OdkExamVersion[]     @relation("OdkExamVersions")
  packageLinks        OdkPackageExam[]
  attempts            OdkExamAttempt[]
  assignments         OdkExamAssignment[]
  importAudits        OdkImportAudit[]

  @@index([family, status, startsAt])
  @@index([examFamilyRefId, status, startsAt])
  @@index([seriesId, startsAt])
  @@index([status, startsAt, endsAt])
  @@index([internalCode])
  @@index([examFamilyRefId])
  @@map("odk_exams")
}

/// Yayına alınan sürüm kilitlenir; daha sonraki düzeltme yeni sürüm oluşturur.
model OdkExamVersion {
  id                 String                 @id @default(cuid())
  examId             String                 @map("exam_id")
  versionNumber      Int                    @map("version_number")
  status             OdkExamVersionStatus   @default(DRAFT)
  durationMinutes    Int                    @map("duration_minutes")
  instructions       String?
  autoSubmit         Boolean                @default(true) @map("auto_submit")
  extraTimePolicy    Json?                  @map("extra_time_policy")
  settings           Json                   @default("{}")
  scoringPolicyId    String                 @map("scoring_policy_id")
  createdById        String                 @map("created_by_id")
  lockedAt           DateTime?              @map("locked_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  exam               OdkExam                @relation("OdkExamVersions", fields: [examId], references: [id], onDelete: Cascade)
  currentForExam     OdkExam?               @relation("OdkCurrentExamVersion")
  scoringPolicy      OdkScoringPolicy       @relation(fields: [scoringPolicyId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation("OdkExamVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections           OdkExamSection[]
  files              OdkExamFile[]
  attempts           OdkExamAttempt[]
  answerKeyRevisions OdkAnswerKeyRevision[]
  importAudits       OdkImportAudit[]

  @@unique([examId, versionNumber])
  @@index([examId, status])
  @@index([createdById, createdAt])
  @@map("odk_exam_versions")
}

model OdkScoringPolicy {
  id               String           @id @default(cuid())
  code             String           @unique
  title            String
  wrongPenalty     Decimal          @map("wrong_penalty") @db.Decimal(5, 2)
  minimumNetIsZero Boolean          @default(true) @map("minimum_net_is_zero")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  versions         OdkExamVersion[]

  @@map("odk_scoring_policies")
}

model OdkExamSection {
  id              String            @id @default(cuid())
  versionId       String            @map("version_id")
  code            String
  title           String
  position        Int
  questionCount   Int               @map("question_count")
  durationMinutes Int?              @map("duration_minutes")
  questionStart   Int?              @map("question_start")
  questionEnd     Int?              @map("question_end")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         OdkExamVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions       OdkExamQuestion[]

  @@unique([versionId, code])
  @@unique([versionId, position])
  @@index([versionId, position])
  @@map("odk_exam_sections")
}

/// Soru metnini zorunlu tutmaz; PDF/image/URL veya gelecekte rich content referansı taşır.
model OdkExamQuestion {
  id                      String                     @id @default(cuid())
  sectionId               String                     @map("section_id")
  questionNumber          Int                        @map("question_number")
  position                Int
  bookletCode             String                     @default("A") @map("booklet_code")
  bookletQuestionNumber   Int?                       @map("booklet_question_number")
  canonicalQuestionNumber Int?                       @map("canonical_question_number")
  contentType             OdkQuestionContentType     @default(BOOKLET_PDF) @map("content_type")
  contentText             String?                    @map("content_text")
  assetUrl                String?                    @map("asset_url")
  correctOption           OdkAnswerOption?           @map("correct_option")
  difficulty              OdkQuestionDifficulty      @default(MEDIUM)
  bookletPage             Int?                       @map("booklet_page")
  isActive                Boolean                    @default(true) @map("is_active")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  section                 OdkExamSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  outcomes                OdkQuestionOutcome[]
  attemptAnswers          OdkAttemptAnswer[]
  attemptResults          OdkAttemptQuestionResult[]
  events                  OdkAttemptEvent[]
  timings                 OdkAttemptQuestionTiming[]

  @@unique([sectionId, questionNumber])
  @@unique([sectionId, position])
  @@index([sectionId, position])
  @@index([sectionId, bookletCode, bookletQuestionNumber])
  @@map("odk_exam_questions")
}

model OdkQuestionOutcome {
  questionId String          @map("question_id")
  outcomeId  String          @map("outcome_id")
  isPrimary  Boolean         @default(false) @map("is_primary")
  question   OdkExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  outcome    LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@id([questionId, outcomeId])
  @@index([outcomeId, questionId])
  @@map("odk_question_outcomes")
}

/// Blob URL'si değil private pathname saklanır; indirme her istekte yetkilendirilir.
model OdkExamFile {
  id           String          @id @default(cuid())
  versionId    String          @map("version_id")
  type         OdkExamFileType
  blobPathname String          @map("blob_pathname")
  fileName     String          @map("file_name")
  mimeType     String          @map("mime_type")
  byteSize     Int             @map("byte_size")
  checksum     String?
  uploadedById String          @map("uploaded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  version      OdkExamVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("OdkExamFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([versionId, type])
  @@index([uploadedById, createdAt])
  @@map("odk_exam_files")
}

model OdkPackageExam {
  packageId String     @map("package_id")
  examId    String     @map("exam_id")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  package   OdkPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  exam      OdkExam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([packageId, examId])
  @@index([examId])
  @@map("odk_package_exams")
}

/// Öğrencinin kilitli sınav sürümüne bağlı, sunucu saatli çözüm oturumu.
model OdkExamAttempt {
  id                  String                     @id @default(cuid())
  examId              String                     @map("exam_id")
  versionId           String                     @map("version_id")
  studentUserId       String                     @map("student_user_id")
  attemptNumber       Int                        @default(1) @map("attempt_number")
  status              OdkAttemptStatus           @default(IN_PROGRESS)
  bookletCode         String                     @default("A") @map("booklet_code")
  meetAcknowledgedAt  DateTime?                  @map("meet_acknowledged_at") @db.Timestamptz(3)
  startedAt           DateTime                   @default(now()) @map("started_at") @db.Timestamptz(3)
  deadlineAt          DateTime                   @map("deadline_at") @db.Timestamptz(3)
  submittedAt         DateTime?                  @map("submitted_at") @db.Timestamptz(3)
  lastActivityAt      DateTime                   @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  ipHash              String?                    @map("ip_hash")
  clientMeta          Json?                      @map("client_meta")
  sessionTokenHash    String?                    @map("session_token_hash")
  integrityLevel      OdkIntegrityLevel          @default(NORMAL) @map("integrity_level")
  integrityReasons    Json                       @default("[]") @map("integrity_reasons")
  integrityReviewedAt DateTime?                  @map("integrity_reviewed_at") @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  exam                OdkExam                    @relation(fields: [examId], references: [id], onDelete: Restrict)
  version             OdkExamVersion             @relation(fields: [versionId], references: [id], onDelete: Restrict)
  student             User                       @relation("OdkExamAttemptStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  answers             OdkAttemptAnswer[]
  score               OdkAttemptScore?
  events              OdkAttemptEvent[]
  timings             OdkAttemptQuestionTiming[]

  @@unique([examId, studentUserId, attemptNumber])
  @@index([studentUserId, status, deadlineAt])
  @@index([examId, status, startedAt])
  @@index([examId, integrityLevel])
  @@map("odk_exam_attempts")
}

/// Cevaplar soru bazında ve artan revizyonla kaydedilir; istemci tekrarları güvenlidir.
model OdkAttemptAnswer {
  attemptId       String           @map("attempt_id")
  questionId      String           @map("question_id")
  selectedOption  OdkAnswerOption? @map("selected_option")
  isMarked        Boolean          @default(false) @map("is_marked")
  revision        Int              @default(1)
  changedCount    Int              @default(0) @map("changed_count")
  answeredAt      DateTime?        @map("answered_at") @db.Timestamptz(3)
  firstAnsweredAt DateTime?        @map("first_answered_at") @db.Timestamptz(3)
  lastChangedAt   DateTime?        @map("last_changed_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  attempt         OdkExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        OdkExamQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@index([questionId])
  @@map("odk_attempt_answers")
}

/// Kilitli cevap anahtarıyla üretilen, tekrar üretilebilir toplam sonuç.
model OdkAttemptScore {
  attemptId         String                     @id @map("attempt_id")
  correctCount      Int                        @map("correct_count")
  wrongCount        Int                        @map("wrong_count")
  blankCount        Int                        @map("blank_count")
  totalNet          Decimal                    @map("total_net") @db.Decimal(7, 2)
  sectionBreakdown  Json?                      @map("section_breakdown")
  scoringVersion    String                     @map("scoring_version")
  answerKeyHash     String                     @map("answer_key_hash")
  publicationStatus OdkScorePublicationStatus  @default(HIDDEN) @map("publication_status")
  activeDurationMs  Int?                       @map("active_duration_ms")
  scoredById        String                     @map("scored_by_id")
  scoredAt          DateTime                   @default(now()) @map("scored_at") @db.Timestamptz(3)
  attempt           OdkExamAttempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scoredBy          User                       @relation("OdkAttemptScoreAdmin", fields: [scoredById], references: [id], onDelete: Restrict)
  questionResults   OdkAttemptQuestionResult[]
  outcomeScores     OdkAttemptOutcomeScore[]

  @@index([scoredById, scoredAt])
  @@index([publicationStatus])
  @@map("odk_attempt_scores")
}

model OdkAttemptQuestionResult {
  attemptId      String            @map("attempt_id")
  questionId     String            @map("question_id")
  selectedOption OdkAnswerOption?  @map("selected_option")
  correctOption  OdkAnswerOption   @map("correct_option")
  result         OdkQuestionResult
  score          OdkAttemptScore   @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)
  question       OdkExamQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@index([questionId, result])
  @@map("odk_attempt_question_results")
}

model OdkAttemptOutcomeScore {
  attemptId        String          @map("attempt_id")
  outcomeId        String          @map("outcome_id")
  questionCount    Int             @map("question_count")
  correctCount     Int             @map("correct_count")
  wrongCount       Int             @map("wrong_count")
  blankCount       Int             @map("blank_count")
  accuracyRate     Decimal         @map("accuracy_rate") @db.Decimal(5, 2)
  activeDurationMs Int?            @map("active_duration_ms")
  score            OdkAttemptScore @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)
  outcome          LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@id([attemptId, outcomeId])
  @@index([outcomeId, accuracyRate])
  @@map("odk_attempt_outcome_scores")
}

/// Append-only sınav davranış / integrity event logu. High-value eventler tutulur.
model OdkAttemptEvent {
  id               String              @id @default(cuid())
  attemptId        String              @map("attempt_id")
  type             OdkAttemptEventType
  sequence         Int
  questionId       String?             @map("question_id")
  clientOccurredAt DateTime?           @map("client_occurred_at") @db.Timestamptz(3)
  serverOccurredAt DateTime            @default(now()) @map("server_occurred_at") @db.Timestamptz(3)
  metadata         Json?
  attempt          OdkExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         OdkExamQuestion?    @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, sequence])
  @@index([attemptId, type, serverOccurredAt])
  @@index([type, serverOccurredAt])
  @@map("odk_attempt_events")
}

/// Soru odak süreleri — visibilityAware activeDurationMs.
model OdkAttemptQuestionTiming {
  id               String          @id @default(cuid())
  attemptId        String          @map("attempt_id")
  questionId       String          @map("question_id")
  visitCount       Int             @default(1) @map("visit_count")
  activeDurationMs Int             @default(0) @map("active_duration_ms")
  firstEnteredAt   DateTime        @map("first_entered_at") @db.Timestamptz(3)
  lastLeftAt       DateTime?       @map("last_left_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  attempt          OdkExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         OdkExamQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("odk_attempt_question_timings")
}

/// Atama anındaki öğrenci/grup snapshot'ı — sonraki grup değişiminde kaybolmaz.
model OdkExamAssignment {
  id            String              @id @default(cuid())
  examId        String              @map("exam_id")
  studentUserId String              @map("student_user_id")
  source        OdkAssignmentSource
  sourceRefId   String?             @map("source_ref_id")
  snapshot      Json                @default("{}")
  isActive      Boolean             @default(true) @map("is_active")
  assignedById  String              @map("assigned_by_id")
  assignedAt    DateTime            @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz(3)
  exam          OdkExam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       User                @relation("OdkExamAssignmentStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  assignedBy    User                @relation("OdkExamAssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([examId, studentUserId])
  @@index([studentUserId, isActive])
  @@index([examId, isActive, assignedAt])
  @@index([source, sourceRefId])
  @@map("odk_exam_assignments")
}

/// LIVE sonrası cevap anahtarı değişiklikleri audit + rescore tetikleyicisi.
model OdkAnswerKeyRevision {
  id                 String         @id @default(cuid())
  versionId          String         @map("version_id")
  revisionNumber     Int            @map("revision_number")
  reason             String
  previousAnswers    Json           @map("previous_answers")
  nextAnswers        Json           @map("next_answers")
  changedById        String         @map("changed_by_id")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  rescoreRequestedAt DateTime?      @map("rescore_requested_at") @db.Timestamptz(3)
  rescoreCompletedAt DateTime?      @map("rescore_completed_at") @db.Timestamptz(3)
  version            OdkExamVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  changedBy          User           @relation("OdkAnswerKeyRevisionAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([versionId, revisionNumber])
  @@index([changedById, createdAt])
  @@map("odk_answer_key_revisions")
}

/// JSON import preview/commit audit trail. Ham payload güvenli saklanır.
model OdkImportAudit {
  id             String          @id @default(cuid())
  examId         String          @map("exam_id")
  versionId      String          @map("version_id")
  kind           OdkImportKind
  schemaVersion  String          @map("schema_version")
  status         OdkImportStatus @default(PREVIEW)
  payloadHash    String          @map("payload_hash")
  rawPayload     Json            @map("raw_payload")
  previewSummary Json            @map("preview_summary")
  errorCount     Int             @default(0) @map("error_count")
  createdById    String          @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt    DateTime?       @map("committed_at") @db.Timestamptz(3)
  exam           OdkExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  version        OdkExamVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("OdkImportAuditActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([examId, kind, createdAt])
  @@index([versionId, status])
  @@map("odk_import_audits")
}
