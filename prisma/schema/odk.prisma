/// DINO AI YANITI.
///
/// `TeacherAiDraft` ile aynı iskelet: kaynak özeti, sağlayıcı, gecikme, token,
/// maliyet ve `requestKey` ile tekrar-güvenliği. Tablo OLMADAN kullanıcı başına
/// GÜNLÜK KOTA ve MALİYET TAVANI uygulanamazdı — asıl varlık sebebi budur,
/// sohbet geçmişi ikincil.
///
/// `questionKey` izin listesindeki soruyu tutar; serbest metin saklanmaz çünkü
/// serbest metin kabul edilmez (bkz. `lib/dino.ts`).
model DinoAnswer {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  audience    DinoAudience
  questionKey String       @map("question_key")

  /// Veli/eğitmen bir öğrenci hakkında sorduğunda o öğrencinin profili.
  /// Öğrenci kendisi sorduğunda kendi profili.
  subjectStudentId String? @map("subject_student_id")

  provider      AiDraftProvider
  modelName     String?         @map("model_name")
  promptVersion String          @map("prompt_version")
  sourceHash    String          @map("source_hash")
  sourceRefs    Json            @map("source_refs")

  /// `{ text, citations[] }` — doğrulanmış çıktı.
  answer Json

  fallbackReason        String? @map("fallback_reason")
  redactionCount        Int     @default(0) @map("redaction_count")
  latencyMs             Int     @map("latency_ms")
  inputTokens           Int?    @map("input_tokens")
  outputTokens          Int?    @map("output_tokens")
  estimatedCostMicrousd Int?    @map("estimated_cost_microusd")

  requestKey String   @unique @map("request_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user           User            @relation("DinoAnswerUser", fields: [userId], references: [id], onDelete: Cascade)
  subjectStudent StudentProfile? @relation(fields: [subjectStudentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subjectStudentId, createdAt])
  @@map("dino_answers")
}

enum PilotCohortStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ROLLED_BACK
}

enum PilotStopReason {
  GUARDRAIL_BREACH
  SECURITY_INCIDENT
  DATA_QUALITY
  OPERATIONAL
  MANUAL_COMPLETION
}

enum ReviewSourceType {
  MOCK_EXAM_SECTION
  LESSON_OUTCOME
  TEACHER_REFERENCE
}

enum ReviewItemStatus {
  ACTIVE
  MASTERED
  ARCHIVED
}

enum ReviewResponse {
  WRONG
  UNSURE
  CORRECT
}

model PilotCohort {
  id                String              @id @default(cuid())
  groupId           String?             @map("group_id")
  groupNameSnapshot String              @map("group_name_snapshot")
  status            PilotCohortStatus   @default(DRAFT)
  createdById       String              @map("created_by_id")
  requestKey        String              @unique @map("request_key")
  version           Int                 @default(1)
  startedAt         DateTime?           @map("started_at") @db.Timestamptz(3)
  stoppedAt         DateTime?           @map("stopped_at") @db.Timestamptz(3)
  stopReason        PilotStopReason?    @map("stop_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  group             Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy         User                @relation("PilotCohortCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members           PilotCohortMember[]

  @@index([status, createdAt])
  @@index([groupId, status])
  @@map("pilot_cohorts")
}

model PilotCohortMember {
  cohortId  String      @map("cohort_id")
  userId    String      @map("user_id")
  role      UserRole
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  cohort    PilotCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@index([userId, role])
  @@map("pilot_cohort_members")
}

/// ODK grup yapısına bağlı değildir; pilot katılımcıları admin tarafından
/// açıkça seçilir ve koşu yaşam döngüsüyle birlikte erişim kapısı olur.
model OdkPilotRun {
  id          String            @id @default(cuid())
  name        String
  status      PilotCohortStatus @default(DRAFT)
  createdById String            @map("created_by_id")
  requestKey  String            @unique @map("request_key")
  version     Int               @default(1)
  startedAt   DateTime?         @map("started_at") @db.Timestamptz(3)
  stoppedAt   DateTime?         @map("stopped_at") @db.Timestamptz(3)
  stopReason  PilotStopReason?  @map("stop_reason")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   User              @relation("OdkPilotRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     OdkPilotMember[]

  @@index([status, createdAt])
  @@map("odk_pilot_runs")
}

model OdkPilotMember {
  runId     String      @map("run_id")
  userId    String      @map("user_id")
  role      UserRole
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  run       OdkPilotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([runId, userId])
  @@index([userId, role])
  @@map("odk_pilot_members")
}

model MockExam {
  id                   String            @id @default(cuid())
  studentId            String            @map("student_id")
  exam                 CurriculumExam
  examFamilyRefId      String?           @map("exam_family_ref_id")
  title                String?
  publisher            String?
  takenAt              DateTime          @map("taken_at") @db.Timestamptz(3)
  durationMinutes      Int?              @map("duration_minutes")
  nextAction           String?           @map("next_action")
  nextActionApprovedAt DateTime?         @map("next_action_approved_at") @db.Timestamptz(3)
  createdById          String            @map("created_by_id")
  reviewedById         String?           @map("reviewed_by_id")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  student              StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy            User              @relation("MockExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy           User?             @relation("MockExamReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  examFamilyRef        ExamFamily?       @relation(fields: [examFamilyRefId], references: [id], onDelete: Restrict)
  sections             MockExamSection[]

  @@index([studentId, takenAt])
  @@index([exam, takenAt])
  @@index([examFamilyRefId])
  @@map("mock_exams")
}

model MockExamSection {
  id              String                 @id @default(cuid())
  mockExamId      String                 @map("mock_exam_id")
  subjectCode     String                 @map("subject_code")
  subjectName     String                 @map("subject_name")
  questionCount   Int                    @map("question_count")
  correctCount    Int                    @map("correct_count")
  incorrectCount  Int                    @map("incorrect_count")
  blankCount      Int                    @map("blank_count")
  durationMinutes Int?                   @map("duration_minutes")
  position        Int                    @default(0)
  mockExam        MockExam               @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  errors          MockExamSectionError[]
  reviewItems     ReviewItem[]

  @@unique([mockExamId, subjectCode])
  @@index([mockExamId, position])
  @@map("mock_exam_sections")
}

model MockExamSectionError {
  sectionId   String                @map("section_id")
  category    MockExamErrorCategory
  revisedById String?               @map("revised_by_id")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  section     MockExamSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  revisedBy   User?                 @relation("MockExamErrorReviser", fields: [revisedById], references: [id], onDelete: SetNull)

  @@id([sectionId, category])
  @@index([category, updatedAt])
  @@map("mock_exam_section_errors")
}

model ReviewItem {
  id                String           @id @default(cuid())
  studentId         String           @map("student_id")
  sourceType        ReviewSourceType @map("source_type")
  mockExamSectionId String?          @unique @map("mock_exam_section_id")
  lessonId          String?          @map("lesson_id")
  outcomeId         String?          @map("outcome_id")
  createdById       String?          @map("created_by_id")
  title             String
  sourceReference   String           @map("source_reference")
  solutionNote      String?          @map("solution_note")
  stage             Int              @default(0)
  dueAt             DateTime         @map("due_at") @db.Timestamptz(3)
  lastReviewedAt    DateTime?        @map("last_reviewed_at") @db.Timestamptz(3)
  lastDeferredOn    DateTime?        @map("last_deferred_on") @db.Timestamptz(3)
  status            ReviewItemStatus @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockExamSection   MockExamSection? @relation(fields: [mockExamSectionId], references: [id], onDelete: Cascade)
  lesson            Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  outcome           LearningOutcome? @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  createdBy         User?            @relation("ReviewItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attempts          ReviewAttempt[]

  @@unique([studentId, lessonId, outcomeId])
  @@index([studentId, status, dueAt])
  @@index([createdById, status])
  @@map("review_items")
}

model ReviewAttempt {
  id             String         @id @default(cuid())
  reviewItemId   String         @map("review_item_id")
  response       ReviewResponse
  stageBefore    Int            @map("stage_before")
  stageAfter     Int            @map("stage_after")
  nextDueAt      DateTime?      @map("next_due_at") @db.Timestamptz(3)
  idempotencyKey String         @map("idempotency_key")
  reviewedAt     DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  reviewItem     ReviewItem     @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@unique([reviewItemId, idempotencyKey])
  @@index([reviewedAt, response])
  @@map("review_attempts")
}

model OdkPackage {
