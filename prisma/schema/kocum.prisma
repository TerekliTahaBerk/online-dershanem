  homework  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher   User     @relation("TeacherNoteTemplateOwner", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, updatedAt])
  @@map("teacher_note_templates")
}

enum StudentCheckInEnergy {
  LOW
  STEADY
  GOOD
}

enum StudentCheckInConfidence {
  NEED_GUIDANCE
  BUILDING
  CONFIDENT
}

enum StudentCheckInBarrier {
  NONE
  NOT_UNDERSTANDING
  TIME_LOAD
  ACCESS_TECH
  NEED_EXAMPLE
  OTHER
}

enum StudentHelpRequestStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum StudentHelpResponseAction {
  NEXT_LESSON
  EXTRA_EXAMPLE
  PLAN_ADJUSTED
  SHORT_CHECKIN
  RESOURCE_SHARED
  NO_ACTION_NEEDED
}

model StudentCheckIn {
  id               String                   @id @default(cuid())
  studentId        String                   @map("student_id")
  groupId          String                   @map("group_id")
  energy           StudentCheckInEnergy
  confidence       StudentCheckInConfidence
  barrier          StudentCheckInBarrier
  /// Akademik plan yükü hissi — medikal/psikolojik teşhis değildir.
  planLoad         StudentCheckInPlanLoad?  @map("plan_load")
  shareWithTeacher Boolean                  @default(false) @map("share_with_teacher")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  student          StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group            Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  helpRequest      StudentHelpRequest?

  @@index([studentId, createdAt])
  @@index([groupId, shareWithTeacher, createdAt])
  @@map("student_check_ins")
}

model StudentHelpRequest {
  id              String                   @id @default(cuid())
  checkInId       String                   @unique @map("check_in_id")
  studentId       String                   @map("student_id")
  groupId         String                   @map("group_id")
  status          StudentHelpRequestStatus @default(OPEN)
  dueAt           DateTime                 @map("due_at") @db.Timestamptz(3)
  firstResponseAt DateTime?                @map("first_response_at") @db.Timestamptz(3)
  helpful         Boolean?
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  checkIn         StudentCheckIn           @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  student         StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group           Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responses       StudentHelpResponse[]

  @@index([groupId, status, dueAt])
  @@index([studentId, status, createdAt])
  @@map("student_help_requests")
}

model StudentHelpResponse {
  id            String                    @id @default(cuid())
  requestId     String                    @map("request_id")
  respondedById String                    @map("responded_by_id")
  action        StudentHelpResponseAction
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  request       StudentHelpRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  respondedBy   User                      @relation("StudentHelpResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([respondedById, createdAt])
  @@map("student_help_responses")
}
