/// Haftalık plan. `productRefId` planın HANGİ ürüne ait olduğunu taşır —
/// eskiden bu bilgi yalnız API katmanındaki sabit `"OK"` kontrollerinde vardı,
/// bu yüzden bir plana bakıp ürününü söylemek mümkün değildi. Onay akışı
/// artık `Product.requiresPlanApproval` üzerinden dallanır (bkz. migration 0109).
model WeeklyPlan {
  id                    String               @id @default(cuid())
  studentId             String               @map("student_id")
  /// Zorunlu: yeni her plan bir registry ürününe bağlanır. Migration 0109
  /// mevcut satırların tümünü "OK" (Online Koçum) ürününe backfill eder.
  productRefId          String               @map("product_ref_id")
  weekStart             DateTime             @map("week_start") @db.Timestamptz(3)
  status                WeeklyPlanStatus     @default(DRAFT)
  ruleVersion           String               @default("adaptive-v1") @map("rule_version")
  capacityMinutes       Int                  @map("capacity_minutes")
  createdById           String               @map("created_by_id")
  approvedById          String?              @map("approved_by_id")
  approvedAt            DateTime?            @map("approved_at") @db.Timestamptz(3)
  /// Plan bir İNSAN tarafından değil, ürün politikası gereği sistemce onaylandı.
  /// `approvedById` bu durumda NULL kalır: sahte bir kullanıcı kimliği yazılmaz,
  /// böylece "kim onayladı?" sorusu denetimde yanlış bir isme bağlanmaz.
  autoApproved          Boolean              @default(false) @map("auto_approved")
  changeRequestCategory String?              @map("change_request_category")
  version               Int                  @default(1)
  generatedAt           DateTime             @default(now()) @map("generated_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  student               StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  productRef            Product              @relation(fields: [productRefId], references: [id], onDelete: Restrict)
  tasks                 WeeklyPlanTask[]
  revisions             WeeklyPlanRevision[]

  @@unique([studentId, weekStart])
  @@index([status, weekStart])
  @@index([productRefId, weekStart])
  @@map("weekly_plans")
}

/// Online Koçum plan görevi — Dershanem Assignment'tan ayrı domain.
/// ASSIGNMENT kaynaklı görevler tek source of truth olarak Assignment'a referans verir;
/// duplicate AssignmentProgress satırı oluşturulmaz.
///
/// İDEMPOTENCY: bir plan içinde aynı ödeve (ya da aynı öneriye) İKİ görev
/// bağlanamaz. Kural koşullu benzersiz indeksle veritabanında zorlanır
/// (`weekly_plan_tasks_one_per_assignment_ref`,
/// `weekly_plan_tasks_one_per_suggestion_ref`; migration 0100). Prisma şema
/// dili koşullu unique tanımlayamadığı için burada YALNIZ belgelenir —
/// `db push` bu indeksleri düşürür.
model WeeklyPlanTask {
  id                String               @id @default(cuid())
  planId            String               @map("plan_id")
  scheduledFor      DateTime             @map("scheduled_for") @db.Timestamptz(3)
  position          Int
  title             String
  description       String?
  subject           String?
  topic             String?
  taskKind          PlanTaskKind         @default(CUSTOM) @map("task_kind")
  scheduleMode      PlanTaskScheduleMode @default(FLEXIBLE) @map("schedule_mode")
  durationMinutes   Int                  @map("duration_minutes")
  targetType        PlanTaskTargetType   @default(NONE) @map("target_type")
  targetValue       Float?               @map("target_value")
  dueAt             DateTime?            @map("due_at") @db.Timestamptz(3)
  priority          PlanTaskPriority     @default(NORMAL)
  sourceType        WeeklyPlanTaskSource @map("source_type")
  sourceReferenceId String?              @map("source_reference_id")
  reasonCode        WeeklyPlanReason     @map("reason_code")
  status            WeeklyPlanTaskStatus @default(PLANNED)
  startedAt         DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(3)

  /// Gerçekleşen çalışma — planlanan alanlardan ayrı tutulur.
  actualQuestions Int?    @map("actual_questions")
  actualCorrect   Int?    @map("actual_correct")
  actualIncorrect Int?    @map("actual_incorrect")
  actualBlank     Int?    @map("actual_blank")
  actualMinutes   Int?    @map("actual_minutes")
  studentNote     String? @map("student_note")
  difficultyFelt  Int?    @map("difficulty_felt")
  energyFelt      Int?    @map("energy_felt")

  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  plan      WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, scheduledFor, position])
  @@index([planId, status, scheduledFor])
  @@index([sourceType, sourceReferenceId])
  @@map("weekly_plan_tasks")
}

