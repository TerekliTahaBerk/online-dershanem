model InterventionCase {
  id              String                     @id @default(cuid())
  studentId       String                     @map("student_id")
  ruleVersion     String                     @default("intervention-v1") @map("rule_version")
  reasonCode      InterventionReason         @map("reason_code")
  fingerprint     String                     @unique
  explanation     String
  suggestedAction String                     @map("suggested_action")
  evidenceCount   Int                        @map("evidence_count")
  windowStart     DateTime                   @map("window_start") @db.Timestamptz(3)
  windowEnd       DateTime                   @map("window_end") @db.Timestamptz(3)
  dueAt           DateTime                   @map("due_at") @db.Timestamptz(3)
  status          InterventionCaseStatus     @default(OPEN)
  ownerId         String?                    @map("owner_id")
  firstActionAt   DateTime?                  @map("first_action_at") @db.Timestamptz(3)
  snoozedUntil    DateTime?                  @map("snoozed_until") @db.Timestamptz(3)
  resolvedAt      DateTime?                  @map("resolved_at") @db.Timestamptz(3)
  outcomeCode     InterventionOutcome?       @map("outcome_code")
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  student         StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  owner           User?                      @relation("InterventionCaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities      InterventionCaseActivity[]

  @@index([status, dueAt])
  @@index([studentId, status, createdAt])
  @@index([ownerId, status, dueAt])
  @@map("intervention_cases")
}

