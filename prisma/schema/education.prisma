enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OutcomeEvidenceType {
  TAUGHT
  OBSERVED
  INDEPENDENT
  NEEDS_REVIEW
}

enum AiDraftTaskType {
  ASSIGNMENT
  MINI_CHECK
}

enum AiDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  FLAGGED
}

enum AiDraftFlagReason {
  FACTUAL_ERROR
  UNSUPPORTED_CITATION
  UNSAFE_TONE
  PRIVACY
  OTHER
}

enum LessonStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MaterialKind {
  LINK
  PDF
  VIDEO
}

model StudentProfile {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  classLevel String?   @map("class_level")
  schoolName String?   @map("school_name")
  targetGoal String?   @map("target_goal")
  /// LGS | TYT | AYT | TYT_AYT | OTHER — serbest etiket; UI sözlüğüyle hizalı.
  examType   String?   @map("exam_type")
  birthDate  DateTime? @map("birth_date") @db.Date

  /// Tasarımdaki "hedef sıralama 30.000". Serbest metin `targetGoal` sınavı
  /// tutar (ör. "YKS"); sıralama ayrı ve sayısaldır ki karşılaştırılabilsin.
  /// Boşsa ekranda sıralama satırı hiç basılmaz.
  targetRank                  Int?                         @map("target_rank")
  weeklyGoal                  String?                      @map("weekly_goal")
  weeklyGoalUpdatedAt         DateTime?                    @map("weekly_goal_updated_at") @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents                     ParentStudent[]
  enrollments                 Enrollment[]
  notes                       LessonNote[]
  attendances                 Attendance[]
  assignmentProgress          AssignmentProgress[]
  mockExams                   MockExam[]
  reviewItems                 ReviewItem[]
  planPreference              StudentPlanPreference?
  weeklyPlans                 WeeklyPlan[]
  weeklyDigests               WeeklyDigest[]
  interventionCases           InterventionCase[]
  recoveryPackages            RecoveryPackage[]
  assignmentSubmissions       AssignmentSubmission[]
  checkIns                    StudentCheckIn[]
  helpRequests                StudentHelpRequest[]
  coachAssignments            CoachAssignment[]
  teacherAssignments          StudentTeacherAssignment[]
  goals                       StudentGoal[]
  dinoAnswers                 DinoAnswer[]
  parentRelationshipHistory   ParentStudentHistory[]       @relation("ParentRelationshipStudent")
  coachNotes                  CoachNote[]
  weeklyCoachSummaries        WeeklyCoachSummary[]
  planSuggestions             WeeklyPlanSuggestion[]
  timelineEvents              StudentTimelineEvent[]
  crossProductEvents          CrossProductEventOutbox[]
  progressEvidence            StudentProgressEvidence[]
  outcomeMastery              StudentOutcomeMastery[]
  crossProductRecommendations CrossProductRecommendation[]

  @@map("student_profiles")
}

enum WeeklyDigestStatus {
  DRAFT
  PUBLISHED
}

model WeeklyDigest {
  id            String                 @id @default(cuid())
  studentId     String                 @map("student_id")
  weekStart     DateTime               @map("week_start") @db.Timestamptz(3)
  status        WeeklyDigestStatus     @default(DRAFT)
  ruleVersion   String                 @default("calm-digest-v1") @map("rule_version")
  trendBand     String                 @map("trend_band")
  goodThingOne  String                 @map("good_thing_one")
  goodThingTwo  String                 @map("good_thing_two")
  supportArea   String                 @map("support_area")
  homeQuestion  String                 @map("home_question")
  dataThrough   DateTime               @map("data_through") @db.Timestamptz(3)
  generatedById String                 @map("generated_by_id")
  publishedById String?                @map("published_by_id")
  publishedAt   DateTime?              @map("published_at") @db.Timestamptz(3)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  student       StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feedback      WeeklyDigestFeedback[]

  @@unique([studentId, weekStart])
  @@index([status, weekStart])
  @@map("weekly_digests")
}

model WeeklyDigestFeedback {
  id           String       @id @default(cuid())
  digestId     String       @map("digest_id")
  userId       String       @map("user_id")
  viewerRole   UserRole     @map("viewer_role")
  helpful      Boolean?
  anxietyPulse Int?         @map("anxiety_pulse")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  digest       WeeklyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@unique([digestId, userId])
  @@index([viewerRole, createdAt])
  @@map("weekly_digest_feedback")
}

model TeacherProfile {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  subjects      String[] @default([])
  bio           String?
  /// Dahili çalışma notları — veli/öğrenci panellerine asla sızdırılmaz.
  internalNotes String?  @map("internal_notes") @db.Text

  /// Bu personel koçluk da yapıyor mu? Tasarımdaki "Öğretmen + koç" / "Koç"
  /// ayrımı budur — AYRI BİR UserRole DEĞİL. Yalnız koçluk yapan personel de
  /// TEACHER rolündedir, sadece grubu olmaz.
  isCoach Boolean @default(false) @map("is_coach")

  /// Aynı anda taşıyabileceği koçluk öğrencisi sayısı. Boşsa tavan tanımlı
  /// değildir ve kapasite uyarısı üretilmez — uydurma bir sayı varsayılmaz.
  coachCapacity Int? @map("coach_capacity")

  /// Ders öğretmenliği için opsiyonel öğrenci kapasitesi (grup + bireysel bağ).
  maxStudentCapacity Int? @map("max_student_capacity")

  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachAssignments CoachAssignment[]

  @@index([isCoach])
  @@map("teacher_profiles")
}

/// ÖĞRENCİ ↔ ÖĞRETMEN (branş bazlı) — grup üyeliğinden bağımsız ilişki.
/// Aynı (öğrenci, öğretmen, branş) çifti yinelenmez; pasifleştirme `endedAt` ile.
enum ParentRelationshipAction {
  LINKED
  UPDATED
  UNLINKED
}

/// BİREBİR KOÇ GÖRÜŞMESİ.
///
/// GİZLİLİK — iki ayrı not alanı bilinçlidir:
///  - `sharedNote` öğrenciye VE veliye açıktır (ürün sayfası: "veli özeti
///    paylaşılabilir").
///  - `privateNote` yalnız koça ve yöneticiye görünür; veliye ve öğrenciye
///    ASLA gönderilmez. Tasarımın veli ekranları da "private coaching note
///    paylaşılmaz" diyor.
/// İki alanı tek alanda birleştirmek bu sınırı kod içinde tutulamaz hâle
/// getirirdi.
model ParentStudent {
  id              String                 @id @default(cuid())
  parentId        String                 @map("parent_id")
  studentId       String                 @map("student_id")
  /// Anne / Baba / Vasi vb.
  relationship    String?
  primaryContact  Boolean                @default(false) @map("primary_contact")
  canViewAcademic Boolean                @default(true) @map("can_view_academic")
  canViewPayments Boolean                @default(false) @map("can_view_payments")
  active          Boolean                @default(true)
  endedAt         DateTime?              @map("ended_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  parent          User                   @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student         StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  history         ParentStudentHistory[]

  @@unique([parentId, studentId])
  @@index([studentId, active])
  @@index([parentId, active])
  @@map("parent_students")
}

model ParentStudentHistory {
  id              String                   @id @default(cuid())
  parentStudentId String?                  @map("parent_student_id")
  parentId        String                   @map("parent_id")
  studentId       String                   @map("student_id")
  action          ParentRelationshipAction
  relationship    String?
  previousValue   String?                  @map("previous_value")
  actorUserId     String?                  @map("actor_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  parentStudent   ParentStudent?           @relation(fields: [parentStudentId], references: [id], onDelete: SetNull)
  parent          User                     @relation("ParentRelationshipParent", fields: [parentId], references: [id], onDelete: Cascade)
  student         StudentProfile           @relation("ParentRelationshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  actor           User?                    @relation("ParentRelationshipActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([parentId, createdAt])
  @@index([studentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("parent_student_history")
}

model Group {
  id           String               @id @default(cuid())
  name         String
  subject      String
  level        String?
  capacity     Int                  @default(4)
  teacherId    String               @map("teacher_id")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher      User                 @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
  lessons      Lesson[]
  assignments  Assignment[]
  materials    LearningMaterial[]
  checkIns     StudentCheckIn[]
  helpRequests StudentHelpRequest[]
  pilotCohorts PilotCohort[]
  lessonSeries LessonSeries[]

  @@index([teacherId, isActive])
  @@index([name])
  @@map("groups")
}

model LessonSeries {
  id               String    @id @default(cuid())
  groupId          String    @map("group_id")
  teacherId        String    @map("teacher_id")
  title            String
  meetingUrl       String?   @map("meeting_url")
  isActive         Boolean   @default(true) @map("is_active")
  /// ISO weekday 1=Pzt … 7=Paz. Boşsa yalnızca `startsAt` haftalık tekrarı.
  weekdays         Int[]     @default([])
  /// Yerel saat "HH:mm" (Europe/Istanbul).
  startsAtTime     String?   @map("starts_at_time")
  durationMinutes  Int       @default(60) @map("duration_minutes")
  seriesStartsOn   DateTime? @map("series_starts_on") @db.Timestamptz(3)
  seriesEndsOn     DateTime? @map("series_ends_on") @db.Timestamptz(3)
  timezone         String    @default("Europe/Istanbul")
  totalOccurrences Int?      @map("total_occurrences")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  group            Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher          User      @relation("LessonSeriesTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  lessons          Lesson[]

  @@index([groupId, isActive])
  @@index([teacherId, isActive])
  @@map("lesson_series")
}

model Enrollment {
  id        String         @id @default(cuid())
  groupId   String         @map("group_id")
  studentId String         @map("student_id")
  startedAt DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?      @map("ended_at") @db.Timestamptz(3)
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId, endedAt])
  @@index([groupId, endedAt])
  @@map("enrollments")
}

model Lesson {
  id                  String             @id @default(cuid())
  groupId             String             @map("group_id")
  seriesId            String?            @map("series_id")
  teacherId           String             @map("teacher_id")
  title               String
  startsAt            DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime           @map("ends_at") @db.Timestamptz(3)
  status              LessonStatus       @default(PLANNED)
  meetingUrl          String?            @map("meeting_url")
  outcomeSkipReason   String?            @map("outcome_skip_reason")
  closeVersion        Int                @default(0) @map("close_version")
  closeIdempotencyKey String?            @map("close_idempotency_key")
  closeRequestHash    String?            @map("close_request_hash")
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  group               Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  series              LessonSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  teacher             User               @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  notes               LessonNote[]
  attendances         Attendance[]
  assignments         Assignment[]
  materials           LearningMaterial[]
  outcomeLinks        LessonOutcome[]
  reviewItems         ReviewItem[]
  recoveryPackages    RecoveryPackage[]
  teacherAiDrafts     TeacherAiDraft[]

  @@index([teacherId, startsAt])
  @@index([groupId, startsAt])
  @@index([seriesId, startsAt])
  @@index([title])
  @@index([status, startsAt])
  @@index([groupId, status, startsAt])
  @@map("lessons")
}

model TeacherAiDraft {
  id                    String             @id @default(cuid())
  teacherId             String             @map("teacher_id")
  lessonId              String             @map("lesson_id")
  taskType              AiDraftTaskType    @map("task_type")
  status                AiDraftStatus      @default(DRAFT)
  provider              AiDraftProvider
  promptVersion         String             @map("prompt_version")
  modelName             String?            @map("model_name")
  sourceHash            String             @map("source_hash")
  sourceRefs            Json               @map("source_refs")
  originalContent       Json               @map("original_content")
  reviewedContent       Json?              @map("reviewed_content")
  flagReason            AiDraftFlagReason? @map("flag_reason")
  fallbackReason        String?            @map("fallback_reason")
  redactionCount        Int                @default(0) @map("redaction_count")
  latencyMs             Int?               @map("latency_ms")
  inputTokens           Int?               @map("input_tokens")
  outputTokens          Int?               @map("output_tokens")
  estimatedCostMicrousd Int?               @map("estimated_cost_microusd")
  requestKey            String             @unique @map("request_key")
  version               Int                @default(1)
  reviewedAt            DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher               User               @relation("TeacherAiDraftOwner", fields: [teacherId], references: [id], onDelete: Cascade)
  lesson                Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
  @@index([teacherId, status, createdAt])
  @@map("teacher_ai_drafts")
}

model LessonNote {
  id        String          @id @default(cuid())
  lessonId  String          @map("lesson_id")
  studentId String?         @map("student_id")
  topic     String?
  note      String?
  nextGoal  String?         @map("next_goal")
  homework  String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([studentId, updatedAt])
  @@map("lesson_notes")
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String           @map("lesson_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, createdAt])
  @@map("attendances")
}

enum AssignmentProgressStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Assignment {
  id                String                      @id @default(cuid())
  groupId           String                      @map("group_id")
  lessonId          String?                     @map("lesson_id")
  createdById       String                      @map("created_by_id")
  title             String
  description       String?
  dueAt             DateTime                    @map("due_at") @db.Timestamptz(3)
  isActive          Boolean                     @default(true) @map("is_active")
  outcomeSkipReason String?                     @map("outcome_skip_reason")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  group             Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson            Lesson?                     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy         User                        @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  progress          AssignmentProgress[]
  materials         LearningMaterial[]
  outcomeLinks      AssignmentOutcome[]
  recoveryItems     RecoveryPackageItem[]
  evidenceRequired  Boolean                     @default(false) @map("evidence_required")
  rubricCriteria    AssignmentRubricCriterion[]
  submissions       AssignmentSubmission[]

  @@index([groupId, dueAt])
  @@index([createdById, isActive])
  @@map("assignments")
}

model AssignmentProgress {
  id              String                   @id @default(cuid())
  assignmentId    String                   @map("assignment_id")
  studentId       String                   @map("student_id")
  status          AssignmentProgressStatus @default(TODO)
  completedAt     DateTime?                @map("completed_at") @db.Timestamptz(3)
  version         Int                      @default(1)
  lastMutationKey String?                  @map("last_mutation_key")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment      Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, status, updatedAt])
  @@map("assignment_progress")
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum RubricLevel {
  NEEDS_WORK
  DEVELOPING
  MEETS
}

model AssignmentRubricCriterion {
  id           String                  @id @default(cuid())
  assignmentId String                  @map("assignment_id")
  position     Int
  label        String
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  assignment   Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scores       AssignmentRubricScore[]

  @@unique([assignmentId, position])
  @@index([assignmentId])
  @@map("assignment_rubric_criteria")
}

model AssignmentSubmission {
  id             String                     @id @default(cuid())
  assignmentId   String                     @map("assignment_id")
  studentId      String                     @map("student_id")
  attemptNumber  Int                        @map("attempt_number")
  status         AssignmentSubmissionStatus @default(SUBMITTED)
  textEvidence   String                     @map("text_evidence")
  feedback       String?
  idempotencyKey String                     @unique @map("idempotency_key")
  reviewerId     String?                    @map("reviewer_id")
  submittedAt    DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  version        Int                        @default(1)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment     Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer       User?                      @relation("AssignmentSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  scores         AssignmentRubricScore[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, status, submittedAt])
  @@index([studentId, submittedAt])
  @@map("assignment_submissions")
}

model AssignmentRubricScore {
  id           String                    @id @default(cuid())
  submissionId String                    @map("submission_id")
  criterionId  String                    @map("criterion_id")
  level        RubricLevel
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   AssignmentSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion    AssignmentRubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
  @@index([criterionId])
  @@map("assignment_rubric_scores")
}

model LearningMaterial {
  id                String                @id @default(cuid())
  groupId           String                @map("group_id")
  lessonId          String?               @map("lesson_id")
  assignmentId      String?               @map("assignment_id")
  createdById       String                @map("created_by_id")
  title             String
  description       String?
  url               String
  blobPathname      String?               @map("blob_pathname")
  fileName          String?               @map("file_name")
  mimeType          String?               @map("mime_type")
  fileSize          Int?                  @map("file_size")
  captionsAvailable Boolean               @default(false) @map("captions_available")
  transcript        String?
  kind              MaterialKind          @default(LINK)
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  group             Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson            Lesson?               @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignment        Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy         User                  @relation("MaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recoveryItems     RecoveryPackageItem[]

  @@index([groupId, isActive, createdAt])
  @@map("learning_materials")
}

enum RecoveryPackageStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum RecoveryItemKind {
  MATERIAL
  ASSIGNMENT
}

enum RecoveryCheckpointResponse {
  NOT_YET
  NEED_HELP
  READY
}

model RecoveryPackage {
  id                 String                      @id @default(cuid())
  lessonId           String                      @map("lesson_id")
  studentId          String                      @map("student_id")
  status             RecoveryPackageStatus       @default(DRAFT)
  ruleVersion        String                      @default("recovery-v1") @map("rule_version")
  summaryTopic       String                      @map("summary_topic")
  summaryNextStep    String                      @map("summary_next_step")
  checkpointPrompt   String                      @map("checkpoint_prompt")
  checkpointResponse RecoveryCheckpointResponse? @map("checkpoint_response")
  dueAt              DateTime                    @map("due_at") @db.Timestamptz(3)
  generatedById      String                      @map("generated_by_id")
  publishedById      String?                     @map("published_by_id")
  publishedAt        DateTime?                   @map("published_at") @db.Timestamptz(3)
  firstViewedAt      DateTime?                   @map("first_viewed_at") @db.Timestamptz(3)
  completedAt        DateTime?                   @map("completed_at") @db.Timestamptz(3)
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  lesson             Lesson                      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student            StudentProfile              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generatedBy        User                        @relation("RecoveryPackageGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  publishedBy        User?                       @relation("RecoveryPackagePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  items              RecoveryPackageItem[]

  @@unique([lessonId, studentId])
  @@index([studentId, status, dueAt])
  @@index([status, dueAt])
  @@map("recovery_packages")
}

model RecoveryPackageItem {
  id           String            @id @default(cuid())
  packageId    String            @map("package_id")
  kind         RecoveryItemKind
  position     Int
  title        String
  materialId   String?           @map("material_id")
  assignmentId String?           @map("assignment_id")
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  package      RecoveryPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  material     LearningMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  assignment   Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([packageId, position])
  @@index([materialId])
  @@index([assignmentId])
  @@map("recovery_package_items")
}

model CurriculumVersion {
  id           String              @id @default(cuid())
  code         String              @unique
  title        String
  exam         CurriculumExam
  academicYear Int                 @map("academic_year")
  status       CurriculumStatus    @default(DRAFT)
  sourceUrl    String?             @map("source_url")
  createdById  String              @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    User                @relation("CurriculumCreator", fields: [createdById], references: [id], onDelete: Restrict)
  subjects     CurriculumSubject[]
  skills       CurriculumSkill[]

  @@index([exam, academicYear, status])
  @@map("curriculum_versions")
}

model CurriculumSubject {
  id        String            @id @default(cuid())
  versionId String            @map("version_id")
  code      String
  name      String
  position  Int               @default(0)
  version   CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  units     CurriculumUnit[]

  @@unique([versionId, code])
  @@index([versionId, position])
  @@map("curriculum_subjects")
}

model CurriculumUnit {
  id        String            @id @default(cuid())
  subjectId String            @map("subject_id")
  code      String
  name      String
  position  Int               @default(0)
  subject   CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  outcomes  LearningOutcome[]

  @@unique([subjectId, code])
  @@index([subjectId, position])
  @@map("curriculum_units")
}

model CurriculumSkill {
  id        String            @id @default(cuid())
  versionId String            @map("version_id")
  code      String
  name      String
  version   CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  outcomes  OutcomeSkill[]

  @@unique([versionId, code])
  @@map("curriculum_skills")
}

model LearningOutcome {
  id               String                    @id @default(cuid())
  unitId           String                    @map("unit_id")
  code             String
  title            String
  description      String?
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  unit             CurriculumUnit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skills           OutcomeSkill[]
  lessons          LessonOutcome[]
  assignments      AssignmentOutcome[]
  favorites        OutcomeFavorite[]
  reviewItems      ReviewItem[]
  odkQuestions     OdkQuestionOutcome[]
  odkAttemptScores OdkAttemptOutcomeScore[]
  progressEvidence StudentProgressEvidence[]
  outcomeMastery   StudentOutcomeMastery[]

  @@unique([unitId, code])
  @@index([isActive, updatedAt])
  @@map("learning_outcomes")
}

model OutcomeSkill {
  outcomeId String          @map("outcome_id")
  skillId   String          @map("skill_id")
  outcome   LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  skill     CurriculumSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([outcomeId, skillId])
  @@map("outcome_skills")
}

model LessonOutcome {
  lessonId     String              @map("lesson_id")
  outcomeId    String              @map("outcome_id")
  evidenceType OutcomeEvidenceType @default(TAUGHT) @map("evidence_type")
  linkedById   String              @map("linked_by_id")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  lesson       Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  outcome      LearningOutcome     @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  linkedBy     User                @relation("LessonOutcomeLinker", fields: [linkedById], references: [id], onDelete: Restrict)

  @@id([lessonId, outcomeId])
  @@index([outcomeId, evidenceType, createdAt])
  @@map("lesson_outcomes")
}

model AssignmentOutcome {
  assignmentId String          @map("assignment_id")
  outcomeId    String          @map("outcome_id")
  linkedById   String          @map("linked_by_id")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  outcome      LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  linkedBy     User            @relation("AssignmentOutcomeLinker", fields: [linkedById], references: [id], onDelete: Restrict)

  @@id([assignmentId, outcomeId])
  @@index([outcomeId, createdAt])
  @@map("assignment_outcomes")
}

model OutcomeFavorite {
  userId    String          @map("user_id")
  outcomeId String          @map("outcome_id")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome   LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@id([userId, outcomeId])
  @@index([userId, createdAt])
  @@map("outcome_favorites")
}
