generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PANEL — kimlik çekirdeği
//
// Hesap üç yoldan açılır (bkz. `User.registrationSource`):
//  - SELF_SIGNUP: kullanıcı /kayit ile Öğrenci ya da Veli olarak kendisi açar.
//    Kayıt HİÇBİR ürün erişimi vermez.
//  - PURCHASE: PayTR ödemesi sonrası provisioning açar.
//  - ADMIN_INVITE: yönetim davet bağlantısıyla açar (öğretmen/yönetim ve
//    velinin bildirdiği çocuklar).
// ============================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum ProductCode {
  OD
  /**
   * Online Koçum
   */
  OK
  ODK
  /**
   * KPSS Görev 5: ticari akış `Record<ProductCode, …>` tamlığı için enum'a alındı.
   * Erişim/görünürlük hâlâ registry'nin `products.is_active` bayrağına bağlıdır;
   * bkz. `lib/products/codes.ts` (KPSS "legacy" sayılmaz).
   */
  KPSS
}

enum CurriculumExam {
  LGS
  TYT
  AYT
  YDT
}

/// Veri odaklı ürün kataloğu. Legacy ProductCode ve CommerceProduct alanları
/// kademeli geçiş tamamlanana kadar kaynak modellerde paralel tutulur.
model Product {
  id                   String                         @id @default(cuid())
  code                 String                         @unique
  name                 String
  targetAudience       String?                        @map("target_audience")
  isActive             Boolean                        @default(true) @map("is_active")
  /// Haftalık planın aktif olabilmesi için insan (koç/öğretmen) onayı gerekiyor mu?
  /// `true` (varsayılan) = Online Koçum davranışı: plan DRAFT doğar, onaysız
  /// görev tamamlanamaz. `false` = öğretmensiz/otonom ürün (KPSS): plan üretildiği
  /// anda `autoApproved` işaretiyle APPROVED doğar ve onay ucuna hiç uğramaz.
  /// Yeni bir otonom ürün eklendiğinde kod değil, bu satır değişir.
  requiresPlanApproval Boolean                        @default(true) @map("requires_plan_approval")
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  examFamilies         ExamFamily[]
  businessUnits        BusinessUnit[]
  memberships          ProductMembership[]
  progressEvidence     StudentProgressEvidence[]
  commerceOrderLines   CommerceOrderLine[]
  contentRoles         ProductContentRoleAssignment[]
  staffAssignments     ProductStaffAssignment[]
  weeklyPlans          WeeklyPlan[]

  @@map("products")
}

enum ProductContentRole {
  CONTENT_EDITOR
}

/// Ürün başına eğitim içeriği yetkisi (`<ürün>:content:write`, ör. `kpss:content:write`).
/// Ürün üyeliğinden (tüketim hakkı) ve işletme RBAC'ından ayrıdır; bkz. docs/business-rbac.md.
/// Karar mantığı: lib/products/content-permission-matrix.ts
model ProductContentRoleAssignment {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  productId   String             @map("product_id")
  role        ProductContentRole
  grantedById String?            @map("granted_by_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime?          @map("revoked_at") @db.Timestamptz(3)
  user        User               @relation("ProductContentRoleOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?              @relation("ProductContentRoleGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId, role])
  @@index([productId, revokedAt])
  @@map("product_content_role_assignments")
}

/// Ürün başına personel sorumluluğu — kimlik DEĞİL. Platform rolü (`UserRole`)
/// değişmez; bir TEACHER aynı anda OD öğretmeni, Yön koçu ve Deneme Ligi
/// editörü olabilir. Karar mantığı: lib/products/staff-permission-matrix.ts
enum ProductStaffRole {
  /// OD: grup / bireysel öğrencilere ders verir.
  TEACHER
  /// OK (Yön Koçluk): `CoachAssignment` taşıyabilir.
  COACH
  /// ODK (Deneme Ligi): sınav, soru, cevap anahtarı, kazanım, dosya.
  EXAM_EDITOR
  /// ODK: takvim, atama, canlı operasyon, bütünlük incelemesi, istisnai erişim.
  EXAM_OPERATOR
  /// ODK: puanlama, yeniden puanlama, sonuç yayını, cevap anahtarı revizyonu.
  RESULT_PUBLISHER
  /// ODK: yalnız ilişkili öğrencilerin raporlarını okur.
  REPORT_VIEWER
  /// Ürünün operasyon yöneticisi (atama, paket).
  PRODUCT_MANAGER
}

enum ProductStaffAssignmentSource {
  MANUAL
  LEGACY_BACKFILL
}

/// Bir satır = bir yetki dönemi. İptal satırı KAPATIR (`revokedAt`), yeniden
/// verme YENİ satır açar; satırlar silinmez ve yeniden kullanılmaz (geçmiş).
///
/// "Aynı (kullanıcı, ürün, rol) için en fazla bir AKTİF satır" kuralı Prisma'da
/// ifade edilemez; migration 0113'teki SQL kısmi tekil indeksiyle korunur
/// (`product_staff_assignments_one_active … WHERE revoked_at IS NULL`).
/// `prisma db push` bu indeksi OLUŞTURMAZ — yalnız migration zinciri kullanın.
model ProductStaffAssignment {
  id           String                       @id @default(cuid())
  userId       String                       @map("user_id")
  productId    String                       @map("product_id")
  role         ProductStaffRole
  source       ProductStaffAssignmentSource @default(MANUAL)
  grantedAt    DateTime                     @default(now()) @map("granted_at") @db.Timestamptz(3)
  /// LEGACY_BACKFILL satırlarında boştur.
  grantedById  String?                      @map("granted_by_id")
  grantReason  String?                      @map("grant_reason")
  revokedAt    DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?                      @map("revoked_by_id")
  revokeReason String?                      @map("revoke_reason")
  user         User                         @relation("ProductStaffAssignmentOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?                        @relation("ProductStaffAssignmentGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy    User?                        @relation("ProductStaffAssignmentRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  product      Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([productId, role, revokedAt])
  @@map("product_staff_assignments")
}

/// Ürüne bağlı, migration gerektirmeden genişletilebilen sınav ailesi kataloğu.
/// Legacy CurriculumExam ve OdkExamFamily alanları geçiş boyunca korunur.
model ExamFamily {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  productId          String              @map("product_id")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  curriculumVersions CurriculumVersion[]
  mockExams          MockExam[]
  odkExamSeries      OdkExamSeries[]
  odkExams           OdkExam[]

  @@index([productId, isActive])
  @@map("exam_families")
}

enum AiDraftProvider {
  OPENAI
  GEMINI
  FALLBACK
  STUB
}

enum AuditActorType {
  SYSTEM
  USER
}
