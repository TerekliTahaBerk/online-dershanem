{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "coverage/",
    "playwright-report/",
    "test-results/",
    "mobile-app/",
    "scripts/",
    "tests/",
    "prisma/migrations/",
    "prisma/seed.mjs",
    "prisma/seed-e2e.ts",
    "prisma/backfill-access-tags.mjs",
    "PayTR IFrame API/",
    "next-env.d.ts",
    "tsconfig.tsbuildinfo"
  ],
  "rules": {
    "react/no-unescaped-entities": "off",
    "@next/next/no-img-element": "warn"
  }
}
